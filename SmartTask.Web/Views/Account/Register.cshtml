@model SmartTask.Web.Models.ViewModels.Account.RegisterViewModel

@{
    ViewData["Title"] = "ثبت نام";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">

    <div class="auth-box">

        <!-- Left Side -->
        <div class="auth-banner">
            <div class="banner-content">

                <h1>SmartTask</h1>

                <p>
                    مدیریت پروژه‌ها،
                    ساده‌تر از همیشه
                </p>

            </div>
        </div>

        <!-- Right Side -->
        <div class="auth-form">

            <div class="form-header">
                <h2>ایجاد حساب</h2>
                <p>به SmartTask خوش آمدید</p>
            </div>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post">

                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="InvitationToken" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <!-- First Name -->
                <div class="mb-3">

                    <div class="input-group-custom">
                        <i class="fa fa-user"></i>

                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="نام"
                               autocomplete="given-name"
                               aria-required="true" />
                    </div>

                    <span asp-validation-for="FirstName"
                          class="text-danger">
                    </span>

                </div>

                <!-- Last Name -->
                <div class="mb-3">

                    <div class="input-group-custom">
                        <i class="fa fa-user"></i>

                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="نام خانوادگی"
                               autocomplete="family-name"
                               aria-required="true" />
                    </div>

                    <span asp-validation-for="LastName"
                          class="text-danger">
                    </span>

                </div>

                <!-- Email -->
                <div class="mb-3">

                    <div class="input-group-custom">
                        <i class="fa fa-at"></i>

                        <input asp-for="Email"
                               class="form-control"
                               placeholder="ایمیل"
                               autocomplete="email"
                               aria-required="true" />
                    </div>

                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>

                </div>

                <!-- Password -->
                <div class="mb-3">

                    <div class="input-group-custom">
                        <i class="fa fa-lock"></i>

                        <input asp-for="Password"
                               class="form-control"
                               placeholder="رمز عبور"
                               autocomplete="new-password"
                               aria-required="true" />
                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger">
                    </span>

                </div>

                <!-- Confirm Password -->
                <div class="mb-4">

                    <div class="input-group-custom">
                        <i class="fa fa-lock"></i>

                        <input asp-for="ConfirmPassword"
                               class="form-control"
                               placeholder="تکرار رمز عبور"
                               autocomplete="new-password"
                               aria-required="true" />
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="auth-submit"
                        aria-label="ایجاد حساب کاربری">
                    ثبت نام
                </button>

            </form>

            <div class="auth-footer">
                حساب کاربری دارید؟
                <a asp-action="Login">
                    ورود
                </a>
            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}