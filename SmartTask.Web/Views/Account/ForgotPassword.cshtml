@model SmartTask.Web.Models.ViewModels.Account.ForgotPasswordViewModel

@{
    ViewData["Title"] = "فراموشی رمز عبور";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">

    <div class="auth-box">

        <div class="auth-banner">

            <div class="banner-content">
                <h1>SmartTask</h1>
                <p>
                    بازیابی رمز عبور
                </p>
            </div>
        </div>

        <div class="auth-form">

            <div class="form-header">
                <h2>
                    فراموشی رمز عبور
                </h2>
                <p>
                    ایمیل خود را وارد کنید.
                </p>
            </div>

            <form asp-action="ForgotPassword" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>
                <div class="mb-4">
                    <div class="input-group-custom">
                        <i class="fa fa-envelope"></i>
                        <input asp-for="Email"
                               placeholder="ایمیل"
                               autocomplete="email"
                               aria-required="true" />
                    </div>
                    <span asp-validation-for="Email"
                          class="text-danger">
                    </span>
                </div>
                <button class="auth-submit" aria-label="ارسال لینک بازیابی رمز عبور">
                    ارسال لینک بازیابی
                </button>

            </form>

            <div class="auth-footer">
                <a asp-action="Login">
                    بازگشت به ورود
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}