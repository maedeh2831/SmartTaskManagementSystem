@model SmartTask.Web.Models.ViewModels.Account.ChangePasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="change-password-page">

    <div class="change-password-header">

        <div>
            <span class="change-password-eyebrow">
                امنیت حساب
            </span>

            <h1>تغییر رمز عبور</h1>

            <p>
                برای حفظ امنیت حساب خود، رمز عبور جدیدی انتخاب کنید.
            </p>
        </div>

        <a asp-action="Profile"
           class="change-password-back">

            <i class="fa-solid fa-arrow-right"></i>

            بازگشت به پروفایل

        </a>

    </div>


    <div class="change-password-layout">

        <!-- Security Info -->
        <div class="security-info-card">

            <div class="security-info-icon">

                <i class="fa-solid fa-shield-halved"></i>

            </div>

            <h2>امنیت حساب شما</h2>

            <p>
                استفاده از یک رمز عبور قوی باعث می‌شود حساب SmartTask
                شما امن‌تر بماند.
            </p>

            <div class="security-rules">

                <div class="security-rule">

                    <span class="rule-icon">
                        <i class="fa-solid fa-check"></i>
                    </span>

                    حداقل ۶ کاراکتر

                </div>

                <div class="security-rule">

                    <span class="rule-icon">
                        <i class="fa-solid fa-check"></i>
                    </span>

                    حداقل یک عدد

                </div>

                <div class="security-rule">

                    <span class="rule-icon">
                        <i class="fa-solid fa-check"></i>
                    </span>

                    استفاده از ترکیب متفاوت کاراکترها

                </div>

            </div>

        </div>


        <!-- Password Form -->
        <div class="password-form-card">

            <div class="password-form-header">

                <div class="password-form-icon">

                    <i class="fa-solid fa-key"></i>

                </div>

                <div>

                    <h2>رمز عبور جدید</h2>

                    <p>
                        اطلاعات زیر را برای تغییر رمز وارد کنید.
                    </p>

                </div>

            </div>


            <form asp-action="ChangePassword"
                  method="post"
                  id="changePasswordForm">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="password-validation">
                </div>


                <!-- Current Password -->
                <div class="password-field">

                    <label asp-for="CurrentPassword"></label>

                    <div class="password-input-wrapper">

                        <i class="fa-solid fa-lock"></i>

                        <input asp-for="CurrentPassword"
                               type="password"
                               class="password-input"
                               autocomplete="current-password"
                               placeholder="رمز عبور فعلی را وارد کنید" />

                        <button type="button"
                                class="toggle-password"
                                data-target="CurrentPassword"
                                aria-label="نمایش رمز عبور">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="CurrentPassword"
                          class="text-danger">
                    </span>

                </div>


                <!-- New Password -->
                <div class="password-field">

                    <label asp-for="NewPassword"></label>

                    <div class="password-input-wrapper">

                        <i class="fa-solid fa-key"></i>

                        <input asp-for="NewPassword"
                               type="password"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="رمز عبور جدید را وارد کنید" />

                        <button type="button"
                                class="toggle-password"
                                data-target="NewPassword"
                                aria-label="نمایش رمز عبور">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <div class="password-strength">

                        <div class="strength-bar">

                            <span id="strengthProgress"></span>

                        </div>

                        <span id="strengthText">
                            قدرت رمز عبور
                        </span>

                    </div>

                    <span asp-validation-for="NewPassword"
                          class="text-danger">
                    </span>

                </div>


                <!-- Confirm Password -->
                <div class="password-field">

                    <label asp-for="ConfirmPassword"></label>

                    <div class="password-input-wrapper">

                        <i class="fa-solid fa-lock"></i>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="password-input"
                               autocomplete="new-password"
                               placeholder="رمز عبور جدید را دوباره وارد کنید" />

                        <button type="button"
                                class="toggle-password"
                                data-target="ConfirmPassword"
                                aria-label="نمایش رمز عبور">

                            <i class="fa-regular fa-eye"></i>

                        </button>

                    </div>

                    <div id="passwordMatch"
                         class="password-match">
                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger">
                    </span>

                </div>


                <div class="password-form-footer">

                    <a asp-action="Profile"
                       class="password-cancel-btn">

                        انصراف

                    </a>

                    <button type="submit"
                            class="password-submit-btn">

                        <i class="fa-solid fa-shield-check"></i>

                        تغییر رمز عبور

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Styles {

    <link rel="stylesheet"
          href="~/css/change-password.css"
          asp-append-version="true" />

}


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* ============================
               Toggle Password
            ============================ */

            document
                .querySelectorAll(".toggle-password")
                .forEach(function (button) {

                    button.addEventListener("click", function () {

                        const targetId =
                            this.dataset.target;

                        const input =
                            document.getElementById(targetId);

                        const icon =
                            this.querySelector("i");

                        if (!input)
                            return;

                        if (input.type === "password") {

                            input.type = "text";

                            icon.classList.remove(
                                "fa-eye"
                            );

                            icon.classList.add(
                                "fa-eye-slash"
                            );

                        }
                        else {

                            input.type = "password";

                            icon.classList.remove(
                                "fa-eye-slash"
                            );

                            icon.classList.add(
                                "fa-eye"
                            );

                        }

                    });

                });


            /* ============================
               Password Strength
            ============================ */

            const newPassword =
                document.getElementById("NewPassword");

            const strengthProgress =
                document.getElementById("strengthProgress");

            const strengthText =
                document.getElementById("strengthText");


            if (newPassword) {

                newPassword.addEventListener(
                    "input",
                    function () {

                        const password =
                            this.value;

                        let score = 0;

                        if (password.length >= 6)
                            score++;

                        if (/[0-9]/.test(password))
                            score++;

                        if (/[a-z]/.test(password))
                            score++;

                        if (/[A-Z]/.test(password))
                            score++;

                        if (/[^A-Za-z0-9]/.test(password))
                            score++;


                        const percentage =
                            Math.min(score * 20, 100);

                        strengthProgress.style.width =
                            percentage + "%";


                        if (!password) {

                            strengthText.textContent =
                                "قدرت رمز عبور";

                        }
                        else if (score <= 2) {

                            strengthText.textContent =
                                "ضعیف";

                        }
                        else if (score <= 3) {

                            strengthText.textContent =
                                "متوسط";

                        }
                        else {

                            strengthText.textContent =
                                "قوی";

                        }

                    }
                );

            }


            /* ============================
               Password Match
            ============================ */

            const confirmPassword =
                document.getElementById("ConfirmPassword");

            const passwordMatch =
                document.getElementById("passwordMatch");


            function checkPasswordMatch() {

                if (!confirmPassword.value) {

                    passwordMatch.textContent = "";

                    return;

                }

                if (
                    newPassword.value ===
                    confirmPassword.value
                ) {

                    passwordMatch.innerHTML =
                        '<i class="fa-solid fa-check"></i> رمزهای عبور یکسان هستند';

                    passwordMatch.classList.add("matched");
                    passwordMatch.classList.remove("not-matched");

                }
                else {

                    passwordMatch.innerHTML =
                        '<i class="fa-solid fa-xmark"></i> رمزهای عبور یکسان نیستند';

                    passwordMatch.classList.add("not-matched");
                    passwordMatch.classList.remove("matched");

                }

            }


            if (confirmPassword) {

                confirmPassword.addEventListener(
                    "input",
                    checkPasswordMatch
                );

            }

            if (newPassword) {

                newPassword.addEventListener(
                    "input",
                    checkPasswordMatch
                );

            }

        });

    </script>

}