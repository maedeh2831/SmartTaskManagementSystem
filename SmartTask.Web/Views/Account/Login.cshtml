@model SmartTask.Web.Models.ViewModels.Account.LoginViewModel

@{
    ViewData["Title"] = "ورود";
    Layout = "_AuthLayout";
}

<div class="container-fluid auth-container">
    <div class="row justify-content-center align-items-center min-vh-100">
        <div class="col-xl-4 col-lg-5 col-md-6">

            <div class="auth-card">
                <div class="text-center mb-4">
                    <div class="auth-icon">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                    </div>
                    <h2>خوش آمدید!</h2>
                    <p>برای ادامه وارد شوید</p>
                </div>

                <form asp-action="Login" method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">ایمیل</label>
                        <input asp-for="Email" class="form-control" placeholder="example@email.com" autocomplete="email" aria-required="true" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">رمز عبور</label>
                        <input asp-for="Password" class="form-control" placeholder="رمز عبور خود را وارد کنید" autocomplete="current-password" aria-required="true" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">مرا به خاطر بسپار</label>
                        </div>
                        <a asp-action="ForgotPassword" class="small">فراموشی رمز</a>
                    </div>

                    <button type="submit" class="auth-btn" aria-label="ورود به حساب کاربری">
                        <i class="fa-solid fa-arrow-right-to-bracket"></i>
                        ورود
                    </button>

                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                </form>

                <div class="mt-3">
                    <form asp-action="ExternalLogin" asp-controller="Account" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="provider" value="Google" />
                        <button type="submit" class="google-btn" aria-label="ورود با حساب Google">
                            <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" alt="Google" />
                            <span>ورود با Google</span>
                        </button>
                    </form>
                </div>

                <div class="text-center mt-4">
                    <span class="text-muted">حساب کاربری ندارید؟ </span>
                    <a asp-action="Register">ثبت نام کنید</a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}