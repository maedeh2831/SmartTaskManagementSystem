@model SmartTask.Web.Models.ViewModels.Account.ResetPasswordViewModel

@{
    ViewData["Title"] = "تغییر رمز عبور";
    Layout = "_AuthLayout";
}

<div class="auth-wrapper">

    <div class="auth-box">

        <div class="auth-banner">

            <div class="banner-content">

                <h1>SmartTask</h1>

                <p>رمز عبور جدید خود را وارد کنید.</p>

            </div>

        </div>

        <div class="auth-form">

            <div class="form-header">

                <h2>تغییر رمز عبور</h2>

                <p>رمز جدید را وارد کنید.</p>

            </div>

            <form asp-action="ResetPassword" method="post">

                <input asp-for="Token" type="hidden" />
                <input asp-for="Email" type="hidden" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="mb-3">

                    <div class="input-group-custom">

                        <i class="fa fa-lock"></i>

                        <input asp-for="Password"
                               placeholder="رمز عبور جدید" />

                    </div>

                    <span asp-validation-for="Password"
                          class="text-danger"></span>

                </div>

                <div class="mb-4">

                    <div class="input-group-custom">

                        <i class="fa fa-lock"></i>

                        <input asp-for="ConfirmPassword"
                               placeholder="تکرار رمز عبور" />

                    </div>

                    <span asp-validation-for="ConfirmPassword"
                          class="text-danger"></span>

                </div>

                <button class="auth-submit">
                    تغییر رمز عبور
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}