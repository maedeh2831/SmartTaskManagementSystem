@model SmartTask.Web.Models.ViewModels.TaskBoard.TaskBoardViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "Task Board";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/task.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/taskboard.css" asp-append-version="true" />
}

<div class="workspace-container">

    <div class="workspace-hero">
        <div class="workspace-hero-content">
            <h1>Task Board — @Model.ProjectName</h1>
            <p>نمای کلی تمام Taskهای این پروژه با قابلیت فیلتر و جستجو.</p>
        </div>

        <div class="workspace-toolbar">
            <div class="workspace-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="boardSearchInput" placeholder="جستجوی Task..." />
            </div>

            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId"
               class="workspace-filter" style="text-decoration:none;">
                <button type="button">
                    <i class="fa-solid fa-arrow-right"></i>
                    بازگشت به پروژه
                </button>
            </a>
        </div>
    </div>

    <!-- ===== Filter Bar ===== -->
    <form method="get" class="board-filter-bar">
        <input type="hidden" name="projectId" value="@Model.ProjectId" />

        <select name="assigneeId" class="form-control" onchange="this.form.submit()">
            <option value="">همه افراد</option>
            @foreach (var a in Model.AvailableAssignees)
            {
                <option value="@a.Id" selected="@(a.Id == Model.SelectedAssigneeId)">@a.Name</option>
            }
        </select>

        <select name="priority" class="form-control" onchange="this.form.submit()">
            <option value="">همه اولویت‌ها</option>
            @foreach (TaskPriorityType p in Enum.GetValues(typeof(TaskPriorityType)))
            {
                <option value="@p" selected="@(p == Model.SelectedPriority)">
                    @(p switch
                    {
                        TaskPriorityType.Lowest => "خیلی کم",
                        TaskPriorityType.Low => "کم",
                        TaskPriorityType.Medium => "متوسط",
                        TaskPriorityType.High => "زیاد",
                        TaskPriorityType.Highest => "خیلی زیاد",
                        _ => "-"
                    })
            </option>
                        }
        </select>

        <select name="type" class="form-control" onchange="this.form.submit()">
            <option value="">همه انواع</option>
            @foreach (TaskType t in Enum.GetValues(typeof(TaskType)))
            {
                <option value="@t" selected="@(t == Model.SelectedType)">
                    @(t switch
                    {
                        TaskType.Task => "Task",
                        TaskType.Bug => "Bug",
                        TaskType.Feature => "Feature",
                        TaskType.Improvement => "بهبود",
                        TaskType.TechnicalDebt => "بدهی فنی",
                        _ => "-"
                    })
            </option>
                        }
        </select>

        @if (Model.AvailableLabels.Any())
        {
            <select name="labelId" class="form-control" onchange="this.form.submit()">
                <option value="">همه Label ها</option>
                @foreach (var l in Model.AvailableLabels)
                {
                    <option value="@l.Id" selected="@(l.Id == Model.SelectedLabelId)">@l.Name</option>
                }
            </select>
        }

        @if (Model.HasActiveFilters)
        {
            <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="board-clear-filters">
                <i class="fa-solid fa-xmark"></i>
                پاک‌کردن فیلترها
            </a>
        }
    </form>

    @if (!Model.Tasks.Any())
    {
        <div class="workspace-empty">
            <i class="fa-solid fa-table-columns"></i>
            <h3>هیچ Task ای با این فیلترها پیدا نشد.</h3>
            <p>فیلترها را تغییر دهید یا از منوی هر User Story یک Task جدید بسازید.</p>
        </div>
    }
    else
    {
        <div class="task-kanban" id="boardKanban">

            @{
                var columns = new[]
                {
                (Status: TaskStatusType.ToDo, Label: "برای انجام", Icon: "fa-circle"),
                (Status: TaskStatusType.InProgress, Label: "درحال انجام", Icon: "fa-spinner"),
                (Status: TaskStatusType.InReview, Label: "درحال بررسی", Icon: "fa-magnifying-glass"),
                (Status: TaskStatusType.Done, Label: "انجام‌شده", Icon: "fa-circle-check"),
                (Status: TaskStatusType.Cancelled, Label: "لغو‌شده", Icon: "fa-circle-xmark")
                };
            }

            @foreach (var col in columns)
            {
                var columnTasks = Model.Tasks.Where(x => x.Status == col.Status).ToList();

                <div class="task-column">
                    <div class="task-column-header status-@col.Status.ToString().ToLower()">
                        <i class="fa-solid @col.Icon"></i>
                        @col.Label
                        <span class="planning-count">@columnTasks.Count</span>
                    </div>

                    <div class="task-list"
                         data-status="@((int)col.Status)"
                         data-can-manage="@Model.CanManage.ToString().ToLower()">

                        @foreach (var task in columnTasks)
                        {
                            <div class="task-card board-task-card" draggable="@(Model.CanManage ? "true" : "false")"
                                 data-id="@task.Id" data-title="@task.Title">

                                @if (Model.CanManage)
                                {
                                    <i class="fa-solid fa-grip-vertical task-drag-handle"></i>
                                }

                                <div class="task-card-body">
                                    <a asp-controller="Task" asp-action="Details" asp-route-id="@task.Id" class="task-card-title">
                                        @task.Title
                                    </a>

                                    <span class="board-story-tag">
                                        <i class="fa-solid fa-book-open"></i>
                                        @task.UserStoryTitle
                                    </span>

                                    @if (task.Labels.Any())
                                    {
                                        <div class="board-label-mini-list">
                                            @foreach (var label in task.Labels)
                                            {
                                                <span class="board-label-mini" style="background:@label.Color" title="@label.Name"></span>
                                            }
                                        </div>
                                    }

                                <div class="task-card-meta">
                                    <span class="task-type-badge type-@task.Type.ToString().ToLower()">
                                        @(task.Type switch
                                        {
                                            TaskType.Task => "Task",
                                            TaskType.Bug => "Bug",
                                            TaskType.Feature => "Feature",
                                            TaskType.Improvement => "بهبود",
                                            TaskType.TechnicalDebt => "بدهی فنی",
                                            _ => "-"
                                        })
                            </span>
                            <span class="backlog-priority-badge priority-@task.Priority.ToString().ToLower()">
                                @task.Priority
                            </span>
                        </div>

                                <div class="task-card-footer">
                            @if (task.Estimate > 0)
                                        {
                                            <span><i class="fa-regular fa-clock"></i> @task.Estimate ساعت</span>
                                        }
                                        @if (task.DueDate.HasValue)
                                        {
                                            <span><i class="fa-regular fa-calendar"></i> @task.DueDate.Value.ToString("MM/dd")</span>
                                        }
                                    </div>

                                    @if (task.AssigneeNames.Any())
                                    {
                                        <div class="board-assignee-list">
                                            @foreach (var name in task.AssigneeNames.Take(3))
                                            {
                                                <span class="board-assignee-avatar" title="@name">
                                                    @name.Substring(0, 1)
                                                </span>
                                            }
                                            @if (task.AssigneeNames.Count > 3)
                                            {
                                                <span class="board-assignee-avatar board-assignee-more">
                                                    +@(task.AssigneeNames.Count - 3)
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>

                            </div>
                        }

                    </div>
                </div>
            }

        </div>
    }

</div>

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <script src="~/js/taskboard.js" asp-append-version="true"></script>
}