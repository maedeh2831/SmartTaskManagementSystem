@model SmartTask.Web.Models.ViewModels.Report.ProjectReportViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "گزارش پروژه";
}
@section Styles
{
    <link rel="stylesheet" href="~/css/workspace-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/report.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
}

<div class="dashboard-page">
    <div class="dashboard-header">
        <div class="dashboard-title">
            <h1>گزارش @Model.ProjectName</h1>
            <p>تحلیل عملکرد Task ها و اعضا در بازه دلخواه</p>
        </div>
        <form method="get" class="report-filter-form">
            <input type="hidden" name="projectId" value="@Model.ProjectId" />
            <input asp-date-name="fromDate" asp-date-value="@Model.FromDate" class="report-date-input" />
            <span>تا</span>
            <input asp-date-name="toDate" asp-date-value="@Model.ToDate" class="report-date-input" />
            <button type="submit" class="btn-report-filter"><i class="fa-solid fa-filter"></i> اعمال فیلتر</button>
        </form>
    </div>

    <div class="report-stats-grid">
        <div class="report-stat-card">
            <span class="report-stat-value">@Model.TotalTasks</span>
            <span class="report-stat-label">کل Task ها</span>
        </div>
        <div class="report-stat-card">
            <span class="report-stat-value">@Model.CompletedTasks</span>
            <span class="report-stat-label">تکمیل‌شده</span>
        </div>
        <div class="report-stat-card">
            <span class="report-stat-value">@Model.CompletionRate%</span>
            <span class="report-stat-label">نرخ تکمیل</span>
        </div>
        <div class="report-stat-card report-stat-danger">
            <span class="report-stat-value">@Model.OverdueTasksCount</span>
            <span class="report-stat-label">عقب‌افتاده</span>
        </div>
    </div>

    <div class="report-tabs">
        <button class="report-tab-btn active" data-tab="tasks">گزارش Task و بهره‌وری</button>
        <button class="report-tab-btn" data-tab="team">گزارش تیمی و عضویت</button>
    </div>

    <div class="report-tab-panel active" id="tab-tasks">
        <div class="report-charts-grid">
            <div class="widget-card">
                <div class="widget-header"><h3>وضعیت Task ها</h3></div>
                <canvas id="taskStatusChart"></canvas>
            </div>
            <div class="widget-card">
                <div class="widget-header"><h3>اولویت Task ها</h3></div>
                <canvas id="taskPriorityChart"></canvas>
            </div>
        </div>

        <div class="widget-card widget-card-wide">
            <div class="widget-header"><h3>Task های عقب‌افتاده</h3></div>
            @if (!Model.TopOverdueTasks.Any())
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-circle-check"></i>
                    <p>هیچ Task عقب‌افتاده‌ای وجود ندارد.</p>
                </div>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr><th>عنوان</th><th>موعد</th><th>روز تأخیر</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.TopOverdueTasks)
                        {
                            <tr>
                                <td>@t.Title</td>
                                <td>@Html.DisplayDate(t.DueDate)</td>
                                <td><span class="report-badge-danger">@t.DaysOverdue روز</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="report-tab-panel" id="tab-team">
        <div class="widget-card widget-card-wide">
            <div class="widget-header"><h3>حجم کاری اعضا</h3></div>
            @if (!Model.MemberWorkload.Any())
            {
                <div class="widget-empty">
                    <i class="fa-solid fa-users"></i>
                    <p>هنوز داده‌ای ثبت نشده است.</p>
                </div>
            }
            else
            {
                <table class="report-table">
                    <thead>
                        <tr><th>عضو</th><th>Task تخصیص‌یافته</th><th>تکمیل‌شده</th><th>زمان ثبت‌شده</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.MemberWorkload)
                        {
                            <tr>
                                <td>@m.FullName</td>
                                <td>@m.AssignedTasksCount</td>
                                <td>@m.CompletedTasksCount</td>
                                <td>@((m.TotalMinutesLogged / 60.0).ToString("0.0")) ساعت</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="report-export-actions">
        <a href="@Url.Action("ExportPdf", new { projectId = Model.ProjectId, fromDate = Model.FromDate, toDate = Model.ToDate })" class="btn-export-pdf">
            <i class="fa-solid fa-file-pdf"></i> خروجی PDF
        </a>
        <a href="@Url.Action("ExportExcel", new { projectId = Model.ProjectId, fromDate = Model.FromDate, toDate = Model.ToDate })" class="btn-export-excel">
            <i class="fa-solid fa-file-excel"></i> خروجی Excel
        </a>
    </div>
</div>

@section Scripts
{
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script>
        const reportData = {
            taskStatus: @Html.Raw(JsonSerializer.Serialize(Model.TaskStatusChart)),
            taskPriority: @Html.Raw(JsonSerializer.Serialize(Model.TaskPriorityChart)),
            timeLog: null
        };
    </script>
    <script src="~/js/report.js" asp-append-version="true"></script>
}