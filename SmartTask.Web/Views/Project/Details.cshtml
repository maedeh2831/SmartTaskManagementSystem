@model SmartTask.Web.Models.ViewModels.Project.ProjectDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/backlog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/taskboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprint.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/workload.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dependency.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/delayrisk.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offroad.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tasktrade.css" asp-append-version="true" />
}

<div class="workspace-container">

    <div class="workspace-hero">

        <div class="workspace-hero-content">

<div class="team-detail-header">

    <div class="preview-logo"
         style="width:64px;height:64px;font-size:26px;background:@Model.Color;">
        <i class="@Model.Icon"></i>
    </div>

    <div>
        <h1 class="project-title-inline mb-0">

            @Model.Name

            <span class="project-key-badge">
                @Model.Key
            </span>

            @if (Model.IsArchived)
            {
                <span class="team-archived-badge">
                    آرشیو شده
                </span>
            }

            @if (Model.CanManage)
            {
                <span class="project-inline-actions">

                    <a asp-action="Edit"
                       asp-route-id="@Model.Id"
                       class="project-edit-inline"
                       title="ویرایش پروژه">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </a>

                    <a asp-controller="Project"
                       asp-action="Settings"
                       asp-route-id="@Model.Id"
                       class="project-edit-inline"
                       title="تنظیمات پروژه">
                        <i class="fa-solid fa-gear"></i>
                    </a>

                </span>
            }

        </h1>

        <p style="margin-bottom:5px !important;">
            @(string.IsNullOrWhiteSpace(Model.Description)
                ? "بدون توضیحات"
                : Model.Description)
        </p>
    </div>

</div>

        </div>

        <div class="workspace-hero-actions">

            <a asp-action="Index"
               asp-route-workspaceId="@Model.WorkspaceId"
               class="workspace-filter"
               style="text-decoration:none; display:inline-flex; align-items:center; gap:8px;">

                <i class="fa-solid fa-arrow-right"></i>
                بازگشت

            </a>

        </div>

    </div>

    <!-- =====================================================
         Tab Bar
         ===================================================== -->
    <div class="project-tabs" id="projectTabs">
        <button class="project-tab-btn active" data-tab="overview">
            <i class="fa-solid fa-bullseye"></i>
            <span>نمای کلی</span>
        </button>
        <button class="project-tab-btn" data-tab="dashboard">
            <i class="fa-solid fa-gauge"></i>
            <span>داشبورد</span>
        </button>
        <button class="project-tab-btn" data-tab="backlog">
            <i class="fa-solid fa-layer-group"></i>
            <span>بک‌لاگ</span>
        </button>
        <button class="project-tab-btn" data-tab="taskboard">
            <i class="fa-solid fa-table-columns"></i>
            <span>Task Board</span>
        </button>
        <button class="project-tab-btn" data-tab="sprints">
            <i class="fa-solid fa-flag-checkered"></i>
            <span>اسپرینت‌ها</span>
        </button>
        <button class="project-tab-btn" data-tab="workload">
            <i class="fa-solid fa-gauge-high"></i>
            <span>بارکاری</span>
        </button>
        <button class="project-tab-btn" data-tab="members">
            <i class="fa-solid fa-users"></i>
            <span>اعضا</span>
        </button>
        <button class="project-tab-btn" data-tab="dependency">
            <i class="fa-solid fa-diagram-project"></i>
            <span>وابستگی</span>
        </button>
        <button class="project-tab-btn" data-tab="delayrisk">
            <i class="fa-solid fa-chart-line"></i>
            <span>پیش‌بینی ریسک</span>
        </button>
        <button class="project-tab-btn" data-tab="offroad">
            <i class="fa-solid fa-route"></i>
            <span>آفرود</span>
        </button>
        <button class="project-tab-btn" data-tab="tasktrade">
            <i class="fa-solid fa-right-left"></i>
            <span>ترید تسک</span>
        </button>
    </div>


    <!-- =====================================================
         Tab: نمای کلی
         ===================================================== -->
    <div class="project-tab-pane active" id="tab-overview">

        <div class="team-stat-grid">
            <div class="team-stat-card">
                <i class="fa-solid fa-circle-info"></i>
                <div>
                    <h4>@Model.Status.GetDisplayName()</h4>
                    <span>وضعیت</span>
                </div>
            </div>
            <div class="team-stat-card">
                <i class="fa-solid fa-flag"></i>
                <div>
                    <h4>@Model.Priority.GetDisplayName()</h4>
                    <span>اولویت</span>
                </div>
            </div>
            <div class="team-stat-card">
                <i class="fa-solid fa-users"></i>
                <div>
                    <h4>@Model.MembersCount</h4>
                    <span>عضو</span>
                </div>
            </div>
            <div class="team-stat-card">
                <i class="fa-solid fa-people-group"></i>
                <div>
                    <h4>@Model.TeamNames.Count</h4>
                    <span>تیم مرتبط</span>
                </div>
            </div>
        </div>

        <div class="team-detail-grid">
            <div class="team-detail-card">
                <h3><i class="fa-regular fa-calendar"></i> زمان‌بندی</h3>
                <div class="project-timeline-row">
                    <div>
                        <span>تاریخ شروع</span>
                        <strong>@Html.DisplayDate(Model.StartDate, "تعیین نشده")</strong>
                    </div>
                    <div>
                        <span>موعد تحویل</span>
                        <strong>@Html.DisplayDate(Model.DueDate, "تعیین نشده")</strong>
                    </div>
                    <div>
                        <span>تاریخ پایان</span>
                        <strong>@Html.DisplayDate(Model.EndDate, "-")</strong>
                    </div>
                </div>
            </div>
            <div class="team-detail-card">
                <h3><i class="fa-solid fa-people-group"></i> تیم‌های مرتبط</h3>
                @if (!Model.TeamNames.Any())
                {
                    <p class="team-empty-text">هیچ تیمی به این پروژه متصل نیست.</p>
                }
                else
                {
                    <div class="team-project-chips">
                        @foreach (var teamName in Model.TeamNames)
                        {
                            <span class="team-project-chip">@teamName</span>
                        }
                    </div>
                }
            </div>
        </div>

        @if (Model.CanManage)
        {
            <div class="team-detail-card" style="margin-top:20px;">
                <h3><i class="fa-solid fa-triangle-exclamation"></i> منطقه خطر</h3>
                <p class="team-empty-text" style="text-align:right;padding:0 0 16px;">حذف پروژه غیرقابل بازگشت است و تمام اطلاعات مرتبط را حذف می‌کند.</p>
                <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="delete-project-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-trash"></i>
                        حذف پروژه
                    </button>
                </form>
            </div>
        }
    </div>


    <!-- =====================================================
         Tab: داشبورد
         ===================================================== -->
    <div class="project-tab-pane" id="tab-dashboard">
        @if (ViewData["DashboardModel"] != null)
        {
            @await Html.PartialAsync("/Views/ProjectDashboard/_DashboardPartial.cshtml", ViewData["DashboardModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: بک‌لاگ
         ===================================================== -->
    <div class="project-tab-pane" id="tab-backlog">
        @if (ViewData["BacklogModel"] != null)
        {
            @await Html.PartialAsync("/Views/Backlog/_BacklogPartial.cshtml", ViewData["BacklogModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: Task Board
         ===================================================== -->
    <div class="project-tab-pane" id="tab-taskboard">
        @if (ViewData["TaskBoardModel"] != null)
        {
            @await Html.PartialAsync("/Views/TaskBoard/_BoardPartial.cshtml", ViewData["TaskBoardModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: اسپرینت‌ها
         ===================================================== -->
    <div class="project-tab-pane" id="tab-sprints">
        @if (ViewData["SprintsModel"] != null)
        {
            @await Html.PartialAsync("/Views/Sprint/_SprintListPartial.cshtml", ViewData["SprintsModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: بارکاری
         ===================================================== -->
    <div class="project-tab-pane" id="tab-workload">
        @if (ViewData["WorkloadModel"] is SmartTask.Web.Models.ViewModels.Workload.WorkloadIndexViewModel workloadVm)
        {
            if (workloadVm.HasActiveSprint)
            {
                <div class="details-card workload-sprint-info">
                    <i class="fa-solid fa-flag-checkered"></i>
                    <div>
                        <strong>@workloadVm.ActiveSprintName</strong>
                        <span>پایان اسپرینت: @Html.DisplayDate(workloadVm.ActiveSprintEndDate)</span>
                    </div>
                </div>
            }
            else
            {
                <div class="workspace-empty" style="margin-bottom:16px;">
                    <i class="fa-solid fa-flag-checkered"></i>
                    <h3>اسپرینت فعالی وجود ندارد.</h3>
                    <p>بارکاری کل پروژه نمایش داده می‌شود.</p>
                </div>
            }

            @await Html.PartialAsync("/Views/Workload/_WorkloadList.cshtml", workloadVm.SprintWorkload)
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: اعضا
         ===================================================== -->
    <div class="project-tab-pane" id="tab-members">
        @if (ViewData["MembersModel"] != null)
        {
            @await Html.PartialAsync("/Views/ProjectMember/_MembersPartial.cshtml", ViewData["MembersModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: وابستگی
         ===================================================== -->
    <div class="project-tab-pane" id="tab-dependency">
        @if (ViewData["DependencyModel"] != null)
        {
            @await Html.PartialAsync("/Views/Dependency/_DependencyPartial.cshtml", ViewData["DependencyModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: پیش‌بینی ریسک
         ===================================================== -->
    <div class="project-tab-pane" id="tab-delayrisk">
        @if (ViewData["DelayRiskModel"] != null)
        {
            @await Html.PartialAsync("/Views/DelayRisk/_DelayRiskPartial.cshtml", ViewData["DelayRiskModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: آفرود
         ===================================================== -->
    <div class="project-tab-pane" id="tab-offroad">
        @if (ViewData["OffroadModel"] != null)
        {
            @await Html.PartialAsync("/Views/Offroad/_OffroadPartial.cshtml", ViewData["OffroadModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>


    <!-- =====================================================
         Tab: ترید تسک
         ===================================================== -->
    <div class="project-tab-pane" id="tab-tasktrade">
        @if (ViewData["TaskTradeModel"] != null)
        {
            @await Html.PartialAsync("/Views/TaskTrade/_TaskTradePartial.cshtml", ViewData["TaskTradeModel"])
        }
        else
        {
            <div class="workspace-empty"><p>داده‌ای یافت نشد</p></div>
        }
    </div>

</div>

@section Scripts
{
    <script src="~/js/project.js" asp-append-version="true"></script>
    <script src="~/js/project-dashboard.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <script src="~/js/taskboard.js" asp-append-version="true"></script>
    <script src="~/js/task-quick-add.js" asp-append-version="true"></script>
    <script src="~/js/vendor/cytoscape.min.js" asp-append-version="true"></script>
    <script src="~/js/vendor/dagre.min.js" asp-append-version="true"></script>
    <script src="~/js/vendor/cytoscape-dagre.min.js" asp-append-version="true"></script>
    <script src="~/js/dependency-graph.js" asp-append-version="true"></script>
    <script src="~/js/dependency.js" asp-append-version="true"></script>
    <script src="~/js/delayrisk.js" asp-append-version="true"></script>
    <script src="~/js/offroad.js" asp-append-version="true"></script>
    <script src="~/js/tasktrade.js" asp-append-version="true"></script>
}