@model SmartTask.Web.Models.ViewModels.ProjectDashboard.ProjectDashboardViewModel

@if (Model.Health != null)
{
    <div class="health-score-card status-@Model.Health.HealthLevel">

        <div class="health-score-main">
            <i class="@Model.Health.HealthIcon health-score-icon"></i>
            <div>
                <div class="health-score-number">@Model.Health.HealthScore<span>/100</span></div>
                <div class="health-score-label">شاخص سلامت پروژه — @Model.Health.HealthLevelDisplay</div>
            </div>
        </div>

        <div class="health-score-breakdown">

            <div class="health-factor">
                <div class="dashboard-donut-wrap health-mini-donut">
                    <svg viewBox="0 0 60 60">
                        <circle cx="30" cy="30" r="24" class="health-mini-track"></circle>
                        <circle cx="30" cy="30" r="24" class="health-mini-value" data-value="@Model.Health.ScheduleHealth"></circle>
                    </svg>
                    <span>@Model.Health.ScheduleHealth</span>
                </div>
                <span>زمان‌بندی</span>
            </div>

            <div class="health-factor">
                <div class="dashboard-donut-wrap health-mini-donut">
                    <svg viewBox="0 0 60 60">
                        <circle cx="30" cy="30" r="24" class="health-mini-track"></circle>
                        <circle cx="30" cy="30" r="24" class="health-mini-value" data-value="@Model.Health.WorkloadHealth"></circle>
                    </svg>
                    <span>@Model.Health.WorkloadHealth</span>
                </div>
                <span>بارکاری</span>
            </div>

            <div class="health-factor">
                <div class="dashboard-donut-wrap health-mini-donut">
                    <svg viewBox="0 0 60 60">
                        <circle cx="30" cy="30" r="24" class="health-mini-track"></circle>
                        <circle cx="30" cy="30" r="24" class="health-mini-value" data-value="@Model.Health.DependencyHealth"></circle>
                    </svg>
                    <span>@Model.Health.DependencyHealth</span>
                </div>
                <span>وابستگی</span>
            </div>

            <div class="health-factor">
                <div class="dashboard-donut-wrap health-mini-donut">
                    <svg viewBox="0 0 60 60">
                        <circle cx="30" cy="30" r="24" class="health-mini-track"></circle>
                        <circle cx="30" cy="30" r="24" class="health-mini-value" data-value="@Model.Health.DeliveryHealth"></circle>
                    </svg>
                    <span>@Model.Health.DeliveryHealth</span>
                </div>
                <span>پیشرفت واقعی</span>
            </div>

        </div>

    </div>

    <!-- AI Button -->
    <div class="my-4">
        <button type="button" id="dashAiBtn" class="ai-generate-btn" style="background:linear-gradient(135deg,#7c3aed,#6d28d9); width:100%;">
            <i class="fa-solid fa-brain"></i> تحلیل سلامت توسط هوش مصنوعی
        </button>
    </div>

    <!-- AI Loading -->
    <div id="dashAiLoading" style="display:none; text-align:center; padding:1rem; color:#a78bfa; margin-top:1rem;">
        <i class="fa-solid fa-spinner fa-spin" style="font-size:1.2rem;"></i>
        <p style="margin-top:0.5rem;">در حال تحلیل...</p>
    </div>

    <!-- AI Error -->
    <div id="dashAiError" style="display:none; text-align:center; padding:0.75rem; color:#ef4444; background:rgba(239,68,68,0.1); border-radius:8px; margin-top:1rem;">
        <p id="dashAiErrorText" style="margin:0;"></p>
    </div>

    <!-- AI Results -->
    <div id="dashAiResult" style="display:none; margin-top:1rem; padding:1.25rem; border-radius:12px; background:linear-gradient(135deg, #1a1a2e, #16213e); border:1px solid rgba(139,92,246,0.3);">

        <div style="display:flex; align-items:center; gap:0.5rem; margin-bottom:1rem;">
            <i class="fa-solid fa-brain" style="color:#a78bfa;"></i>
            <h4 style="margin:0; color:#e2e8f0;">ارزیابی هوش مصنوعی</h4>
        </div>

        <div id="dashAiAssessment" style="background:rgba(139,92,246,0.1); border-radius:8px; padding:0.75rem 1rem; margin-bottom:1rem; border-right:3px solid #8b5cf6; display:none;">
            <p id="dashAiAssessmentText" style="margin:0;  line-height:1.7;"></p>
        </div>

        <div id="dashAiCritical" style="margin-bottom:1rem; display:none;">
            <h5 style="color:#f59e0b; margin-bottom:0.5rem;"><i class="fa-solid fa-triangle-exclamation"></i> بخش‌های بحرانی:</h5>
            <ul id="dashAiCriticalList" style="margin:0; padding-right:1.25rem; color:#e2e8f0;"></ul>
        </div>

        <div id="dashAiRecs" style="margin-bottom:1rem; display:none;">
            <h5 style="color:#34d399; margin-bottom:0.5rem;"><i class="fa-solid fa-lightbulb"></i> پیشنهادات:</h5>
            <ul id="dashAiRecsList" style="margin:0; padding-right:1.25rem; color:#e2e8f0;"></ul>
        </div>

        <div id="dashAiForecast" style="display:none; background:rgba(52,211,153,0.1); border-radius:8px; padding:0.75rem 1rem; border-right:3px solid #34d399;">
            <h5 style="color:#34d399; margin-bottom:0.3rem;"><i class="fa-solid fa-chart-line"></i> پیش‌بینی:</h5>
            <p id="dashAiForecastText" style="margin:0;  line-height:1.7;"></p>
        </div>

    </div>

    <script>
    (function() {
        var token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        var pid = @Model.Health.ProjectId;
        document.getElementById('dashAiBtn')?.addEventListener('click', function() {
            var loading = document.getElementById('dashAiLoading');
            var error = document.getElementById('dashAiError');
            var result = document.getElementById('dashAiResult');
            loading.style.display = 'block'; error.style.display = 'none'; result.style.display = 'none';
            fetch('/ProjectDashboard/GetAiHealthAnalysis?projectId=' + pid, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' }
            }).then(r => r.json()).then(d => {
                loading.style.display = 'none';
                if (!d.success) { error.style.display='block'; document.getElementById('dashAiErrorText').textContent=d.message||'خطا'; return; }
                if (d.aiOverallAssessment) { document.getElementById('dashAiAssessmentText').textContent=d.aiOverallAssessment; document.getElementById('dashAiAssessment').style.display='block'; }
                if (d.aiCriticalAreas && d.aiCriticalAreas.length) { var ul=document.getElementById('dashAiCriticalList'); ul.innerHTML=''; d.aiCriticalAreas.forEach(f=>{ul.innerHTML+='<li style="margin-bottom:0.3rem;">'+f+'</li>';}); document.getElementById('dashAiCritical').style.display='block'; }
                if (d.aiRecommendations && d.aiRecommendations.length) { var ul2=document.getElementById('dashAiRecsList'); ul2.innerHTML=''; d.aiRecommendations.forEach(f=>{ul2.innerHTML+='<li style="margin-bottom:0.3rem;">'+f+'</li>';}); document.getElementById('dashAiRecs').style.display='block'; }
                if (d.aiForecast) { document.getElementById('dashAiForecastText').textContent=d.aiForecast; document.getElementById('dashAiForecast').style.display='block'; }
                result.style.display='block';
            }).catch(()=>{ loading.style.display='none'; error.style.display='block'; document.getElementById('dashAiErrorText').textContent='خطا در ارتباط'; });
        });
    })();
    </script>

}

<!-- Stat Cards -->
<div class="team-stat-grid dashboard-stat-grid">

    <div class="team-stat-card">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <h4>@Model.Status.GetDisplayName()</h4>
            <span>وضعیت پروژه</span>
        </div>
    </div>

    <div class="team-stat-card">
        <i class="fa-solid fa-flag"></i>
        <div>
            <h4>@Model.Priority.GetDisplayName()</h4>
            <span>اولویت</span>
        </div>
    </div>

    <div class="team-stat-card">
        <i class="fa-solid fa-users"></i>
        <div>
            <h4>@Model.MembersCount</h4>
            <span>عضو پروژه</span>
        </div>
    </div>

    <div class="team-stat-card">
        <i class="fa-solid fa-people-group"></i>
        <div>
            <h4>@Model.TeamsCount</h4>
            <span>تیم مرتبط</span>
        </div>
    </div>

</div>

<!-- Charts Row -->
<div class="dashboard-charts-grid">

    <!-- Completion Donut -->
    <div class="team-detail-card dashboard-chart-card">
        <h3><i class="fa-solid fa-chart-pie"></i> پیشرفت پروژه</h3>

        <div class="dashboard-donut-wrap">
            <svg viewBox="0 0 120 120" class="dashboard-donut" data-progress="@Model.ProgressPercentage">
                <circle cx="60" cy="60" r="52" class="donut-track"></circle>
                <circle cx="60" cy="60" r="52" class="donut-value" style="stroke:@Model.Color"></circle>
            </svg>
            <div class="dashboard-donut-label">
                <strong>@Model.ProgressPercentage%</strong>
                <span>پیشرفت</span>
            </div>
        </div>

        @if (Model.DueDate.HasValue)
        {
            <div class="dashboard-timeline-info @(Model.IsOverdue ? "overdue" : "")">
                <i class="fa-regular fa-calendar"></i>
                @if (Model.IsOverdue)
                {
                    <span>@Math.Abs(Model.DaysRemaining!.Value) روز از موعد گذشته</span>
                }
                else if (Model.DaysRemaining.HasValue)
                {
                    <span>@Model.DaysRemaining روز تا موعد تحویل باقی مانده</span>
                }
            </div>
        }
        else
        {
            <p class="team-empty-text">موعد تحویلی برای این پروژه تعیین نشده است.</p>
        }
    </div>

    <!-- Member Workload -->
    <div class="team-detail-card dashboard-chart-card">
        <h3><i class="fa-solid fa-users-gear"></i> توزیع نقش اعضا</h3>

        @if (!Model.RoleDistribution.Any())
        {
            <p class="team-empty-text">هنوز عضوی به این پروژه اضافه نشده است.</p>
        }
        else
        {
            <div class="dashboard-bar-list">
                @{
                    var maxCount = Model.RoleDistribution.Max(x => x.Count);
                }
                @foreach (var item in Model.RoleDistribution)
                {
                    var widthPercent = maxCount == 0 ? 0 : (item.Count * 100 / maxCount);
                    <div class="dashboard-bar-row">
                        <span class="dashboard-bar-label">@item.Role.GetDisplayName()</span>
                        <div class="dashboard-bar-track">
                            <div class="dashboard-bar-fill role-@item.Role.ToString().ToLower()" style="width:@widthPercent%"></div>
                        </div>
                        <span class="dashboard-bar-count">@item.Count</span>
                    </div>
                }
            </div>
        }
    </div>

</div>

<!-- Bottom Row -->
<div class="dashboard-charts-grid">

    <!-- Recent Activity -->
    <div class="team-detail-card">
        <h3><i class="fa-solid fa-clock-rotate-left"></i> آخرین اعضای اضافه‌شده</h3>

        @if (!Model.RecentMembers.Any())
        {
            <p class="team-empty-text">فعالیتی ثبت نشده است.</p>
        }
        else
        {
            <div class="dashboard-activity-list">
                @foreach (var member in Model.RecentMembers)
                {
                    <div class="dashboard-activity-item">
                        <div class="preview-logo" style="width:38px;height:38px;font-size:14px;">
                            <i class="fa-solid fa-user"></i>
                        </div>
                        <div class="dashboard-activity-text">
                            <strong>@member.FullName</strong>
                            <span>با نقش @member.Role.GetDisplayName() به پروژه پیوست</span>
                        </div>
                        <small>@Html.DisplayDate(member.JoinedDate)</small>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Team Widget -->
    <div class="team-detail-card">
        <h3><i class="fa-solid fa-people-group"></i> تیم‌های مرتبط</h3>

        @if (!Model.TeamNames.Any())
        {
            <p class="team-empty-text">هیچ تیمی به این پروژه متصل نیست.</p>
        }
        else
        {
            <div class="team-project-chips">
                @foreach (var teamName in Model.TeamNames)
                {
                    <span class="team-project-chip">@teamName</span>
                }
            </div>
        }
    </div>

</div>
