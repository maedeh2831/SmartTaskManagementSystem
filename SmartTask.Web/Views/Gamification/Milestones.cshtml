@{
    ViewData["Title"] = "مسیر پیشرفت";
}

<style>
    .mile-container { max-width: 1200px; margin: 0 auto; padding: 1.5rem; }
    .mile-header { margin-bottom: 2rem; }
    .mile-header h1 { font-size: 1.75rem; font-weight: 700; color: var(--text); }
    .mile-header p { color: var(--gray500); margin-top: .25rem; }

    .mile-list { display: flex; flex-direction: column; gap: 1rem; }
    .mile-card { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; display: flex; gap: 1.25rem; align-items: flex-start; transition: all .25s; }
    .mile-card:hover { box-shadow: 0 4px 16px rgba(0,0,0,.06); }
    .mile-icon { font-size: 2rem; width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; background: var(--bg); border-radius: 12px; flex-shrink: 0; }
    .mile-card.completed .mile-icon { background: #dcfce7; }
    .mile-body { flex: 1; }
    .mile-body h3 { font-size: 1rem; font-weight: 600; color: var(--text); margin-bottom: .25rem; }
    .mile-body p { font-size: .85rem; color: var(--gray500); line-height: 1.5; }
    .mile-progress { margin-top: .5rem; }
    .mile-progress .bar { height: 8px; background: var(--gray200); border-radius: 4px; overflow: hidden; }
    .mile-progress .fill { height: 100%; border-radius: 4px; background: var(--primary); transition: width .5s ease; }
    .mile-progress .text { font-size: .75rem; color: var(--gray500); margin-top: .25rem; display: flex; justify-content: space-between; }
    .mile-reward { display: inline-flex; align-items: center; gap: .35rem; margin-top: .5rem; font-size: .8rem; color: var(--warning); font-weight: 600; }
    .empty-state { text-align: center; padding: 3rem; color: var(--gray400); }
    .empty-state i { font-size: 3rem; margin-bottom: 1rem; display: block; color: var(--primary); }
</style>

<div class="mile-container">
    <div class="mile-header">
        <h1>🏁 مسیر پیشرفت</h1>
        <p>نقشه راه پیشرفت و جوایز هر مرحله</p>
    </div>
    <div id="mileList" class="mile-list">
        <div class="empty-state"><i class="fa-solid fa-spinner fa-spin"></i><p>در حال بارگذاری...</p></div>
    </div>
</div>

<script>
    (function() {
        fetch('/api/gamification/milestones')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                var milestones = data.milestones || data || [];
                var el = document.getElementById('mileList');
                if (!milestones || milestones.length === 0) {
                    el.innerHTML = '<div class="empty-state"><i class="fa-solid fa-flag-checkered"></i><p>هنوز مسیر پیشرفتی تعریف نشده</p></div>';
                    return;
                }
                var html = '';
                milestones.forEach(function(m) {
                    var completed = m.isCompleted || m.isAchieved || false;
                    var progress = m.progressPercent || (completed ? 100 : 0);
                    html += '<div class="mile-card ' + (completed ? 'completed' : '') + '">';
                    html += '<div class="mile-icon">' + (m.icon || '🏁') + '</div>';
                    html += '<div class="mile-body">';
                    html += '<h3>' + (m.name || m.title || '—') + '</h3>';
                    html += '<p>' + (m.description || '') + '</p>';
                    html += '<div class="mile-progress"><div class="bar"><div class="fill" style="width:' + progress + '%;"></div></div>';
                    html += '<div class="text"><span>' + progress + '%</span><span>' + (completed ? '✓ تکمیل' : 'در حال پیشرفت') + '</span></div></div>';
                    if (m.rewardXp || m.rewardPoints) { html += '<div class="mile-reward">🎁 + ' + (m.rewardXp || m.rewardPoints) + ' XP</div>'; }
                    html += '</div></div>';
                });
                el.innerHTML = html;
            })
            .catch(function() {
                document.getElementById('mileList').innerHTML = '<div class="empty-state"><i class="fa-solid fa-exclamation-triangle"></i><p>خطا در بارگذاری</p></div>';
            });
    })();
</script>
