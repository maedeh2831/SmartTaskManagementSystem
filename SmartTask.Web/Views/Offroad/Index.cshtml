@model SmartTask.Web.Models.ViewModels.Offroad.OffroadIndexViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "آفرود";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/offroad.css" asp-append-version="true" />
}

<div class="workspace-container">

    <div class="workspace-hero">
        <div class="workspace-hero-content">
            <h1><i class="fa-solid fa-route"></i> آفرود — @Model.ProjectName</h1>
            <p>کارهای ضروری خارج از دامنه رسمی پروژه را همین‌جا ثبت و پیگیری کنید.</p>
        </div>

        <div class="workspace-toolbar">
            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="workspace-filter" style="text-decoration:none;">
                <button type="button">
                    <i class="fa-solid fa-arrow-right"></i>
                    بازگشت به پروژه
                </button>
            </a>
        </div>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-plus"></i>
            ثبت کار آفرود جدید
        </div>

        <form asp-action="QuickAdd" method="post" class="offroad-quick-add-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ProjectId" value="@Model.ProjectId" />

            <div class="offroad-form-row">
                <input type="text" name="Title" class="form-control" placeholder="عنوان کار (مثلاً: رفع مشکل سرور استیجینگ)" required maxlength="200" />

                <select name="Priority" class="form-control offroad-select-sm">
                    <option value="@((int)OffroadPriorityType.Low)">کم</option>
                    <option value="@((int)OffroadPriorityType.Normal)" selected>معمولی</option>
                    <option value="@((int)OffroadPriorityType.Urgent)">فوری</option>
                </select>

                <select name="AssignedToUserId" class="form-control offroad-select-sm">
                    <option value="">— تخصیص (اختیاری) —</option>
                    @foreach (var member in Model.ProjectMembers)
                    {
                        <option value="@member.Value">@member.Text</option>
                    }
                </select>

                <input asp-date-name="DueDate" class="form-control offroad-select-sm" />

                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    ثبت
                </button>
            </div>

            <textarea name="Description" class="form-control" rows="2" placeholder="توضیح بیشتر (اختیاری)..." style="margin-top:12px;"></textarea>
        </form>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-list-check"></i>
            لیست کارهای آفرود
            <span class="subtask-progress-text">(@Model.Tasks.Count)</span>
        </div>

        @if (!Model.Tasks.Any())
        {
            <div class="team-empty-text">هنوز کار آفرودی ثبت نشده است.</div>
        }
        else
        {
            <div class="offroad-list" data-project-id="@Model.ProjectId">
                @foreach (var task in Model.Tasks)
                {
                    <div class="offroad-row @(task.Status == OffroadStatusType.Done ? "done" : "")" data-id="@task.Id">

                        <div class="offroad-row-main">
                            <h4>@task.Title</h4>
                            @if (!string.IsNullOrWhiteSpace(task.Description))
                            {
                                <p>@task.Description</p>
                            }
                            <div class="offroad-row-meta">
                                <span><i class="fa-regular fa-user"></i> ثبت‌کننده: @task.CreatedByName</span>
                                @if (!string.IsNullOrWhiteSpace(task.AssignedToName))
                                {
                                    <span><i class="fa-solid fa-user-check"></i> تخصیص به: @task.AssignedToName</span>
                                }
                                @if (task.DueDate.HasValue)
                                {
                                    <span><i class="fa-regular fa-calendar"></i> موعد: @Html.DisplayDate(task.DueDate)</span>
                                }
                            </div>
                        </div>

                        <div class="offroad-row-actions">

                            <select class="form-control offroad-status-select" data-id="@task.Id" @(task.CanManage ? "" : "disabled")>
                                <option value="@((int)OffroadStatusType.ToDo)" selected="@(task.Status == OffroadStatusType.ToDo)">برای انجام</option>
                                <option value="@((int)OffroadStatusType.InProgress)" selected="@(task.Status == OffroadStatusType.InProgress)">درحال انجام</option>
                                <option value="@((int)OffroadStatusType.Done)" selected="@(task.Status == OffroadStatusType.Done)">انجام‌شده</option>
                            </select>

                            <select class="form-control offroad-priority-select priority-@task.Priority.ToString().ToLower()" data-id="@task.Id" @(task.CanManage ? "" : "disabled")>
                                <option value="@((int)OffroadPriorityType.Low)" selected="@(task.Priority == OffroadPriorityType.Low)">کم</option>
                                <option value="@((int)OffroadPriorityType.Normal)" selected="@(task.Priority == OffroadPriorityType.Normal)">معمولی</option>
                                <option value="@((int)OffroadPriorityType.Urgent)" selected="@(task.Priority == OffroadPriorityType.Urgent)">فوری</option>
                            </select>

                            @if (task.CanManage)
                            {
                                <form asp-action="Delete" method="post" class="delete-offroad-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@task.Id" />
                                    <input type="hidden" name="projectId" value="@Model.ProjectId" />
                                    <button type="submit" class="workspace-delete-btn">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            }

                        </div>

                    </div>
                }
            </div>
        }
    </div>

</div>

@section Scripts
{
    <script src="~/js/offroad.js" asp-append-version="true"></script>
}