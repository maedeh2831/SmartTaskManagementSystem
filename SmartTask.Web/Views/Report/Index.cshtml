@model SmartTask.Web.Models.ViewModels.Workspace.WorkspaceIndexViewModel

@{
    ViewData["Title"] = "گزارش‌ها";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
}

<div class="workspace-container">

    <div class="workspace-hero">
        <div class="workspace-hero-content">
            <h1>گزارش‌ها</h1>
            <p>یک فضای کاری را انتخاب کنید تا گزارش عملکرد آن را ببینید.</p>
        </div>

        <div class="workspace-toolbar">
            <div class="workspace-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" placeholder="جستجوی فضای کاری..." />
            </div>
        </div>
    </div>

    @if (!Model.Workspaces.Any())
    {
        <div class="workspace-empty">
            <i class="fa-solid fa-chart-line"></i>
            <h3>هنوز فضای کاری‌ای ندارید.</h3>
            <p>برای مشاهده گزارش، ابتدا یک فضای کاری بسازید.</p>
        </div>
    }
    else
    {
        <div class="workspace-grid">
            @foreach (var item in Model.Workspaces)
            {
                <div class="workspace-card">
                    <div class="workspace-card-header" style="background:@item.Color">
                        <div class="workspace-logo">
                            @if (!string.IsNullOrWhiteSpace(item.Logo))
                            {
                                <img src="@item.Logo" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-layer-group"></i>
                            }
                        </div>
                        <span class="workspace-status">@item.Visibility</span>
                    </div>

                    <div class="workspace-card-content">
                        <h3>@item.Name</h3>
                        <p>@(string.IsNullOrWhiteSpace(item.Description) ? "بدون توضیحات" : item.Description)</p>

                        <div class="workspace-info">
                            <div>
                                <i class="fa-solid fa-folder"></i>
                                <span>@item.ProjectsCount پروژه</span>
                            </div>
                            <div>
                                <i class="fa-solid fa-users"></i>
                                <span>@item.MembersCount عضو</span>
                            </div>
                        </div>
                    </div>

                    <div class="workspace-card-footer">
                        <small>@item.CreateDate.ToString("yyyy/MM/dd")</small>

                        <div class="workspace-actions">
                            <a asp-controller="WorkspaceReport"
                               asp-action="Index"
                               asp-route-workspaceId="@item.Id"
                               class="workspace-open-btn">
                                مشاهده گزارش
                                <i class="fa-solid fa-arrow-left"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

</div>

@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
}