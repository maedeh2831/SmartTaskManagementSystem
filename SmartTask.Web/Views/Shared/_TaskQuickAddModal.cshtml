<div class="modal fade" id="taskQuickAddModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content quick-add-modal">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fa-solid fa-bolt"></i>
                    Task جدید
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="quick-add-steps">
                    <span class="step active" data-step="1"><i class="fa-solid fa-bookmark"></i> User Story</span>
                    <span class="step" data-step="2"><i class="fa-solid fa-square-check"></i> جزئیات</span>
                </div>

                <div class="quick-add-step" id="tqaStep1">
                    <input type="text" id="tqaStoryFilter" class="qa-filter-input" placeholder="جستجوی User Story..." />
                    <div class="qa-story-list" id="tqaStoryList">
                        <div class="qa-loading">در حال بارگذاری...</div>
                    </div>
                </div>

                <div class="quick-add-step d-none" id="tqaStep2">
                    <button type="button" class="qa-back-btn" data-back="1">
                        <i class="fa-solid fa-arrow-right"></i> بازگشت به User Story‌ها
                    </button>
                    <form id="tqaTaskForm">
                        <div class="qa-field">
                            <label>عنوان Task</label>
                            <input type="text" id="tqaTaskTitle" required maxlength="200" placeholder="مثلاً: پیاده‌سازی صفحه ورود" autocomplete="off" />
                        </div>
                        <div class="qa-field">
                            <label>اولویت</label>
                            <select id="tqaTaskPriority">
                                <option value="Lowest">خیلی کم</option>
                                <option value="Low">کم</option>
                                <option value="Medium" selected>متوسط</option>
                                <option value="High">زیاد</option>
                                <option value="Highest">خیلی زیاد</option>
                            </select>
                        </div>
                        <button type="submit" class="qa-submit-btn">
                            <i class="fa-solid fa-check"></i>
                            ساخت Task
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>