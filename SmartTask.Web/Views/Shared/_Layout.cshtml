@inject SmartTask.Web.Infrastructure.Interfaces.ICurrentUserService CurrentUserService
@{
    var themePreference = "system";
    var isJalaliDate = false;
    if (CurrentUserService.IsAuthenticated && CurrentUserService.CurrentUser != null)
    {
        themePreference = CurrentUserService.CurrentUser.Theme.ToString().ToLower();
        isJalaliDate = CurrentUserService.CurrentUser.DateFormat == SmartTask.Web.Models.Enums.DateFormatType.Jalali;
    }
}

<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script>
        (function () {
            var stored = "@themePreference";
            var theme = stored;
            if (stored === "system" || !stored) {
                theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
            }
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-preference", stored || "system");
        })();
    </script>
    
    <title>@ViewData["Title"] - SmartTask</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    @if (isJalaliDate)
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/persian-datepicker@latest/dist/css/persian-datepicker.min.css" />
    }
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom-select.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom-scrollbar.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/node_modules/tippy.js/dist/tippy.css" />
    <link rel="stylesheet" href="~/node_modules/tippy.js/animations/shift-away-subtle.css" />
    <!-- Preload all page CSS for instant SPA navigation -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/workspace-pages.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/project-dashboard.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/home-dashboard.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/workspace-dashboard.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/backlog.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/taskboard.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/task.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/task-pages.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/sprint.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/workload.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/dependency.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/delayrisk.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/offroad.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/tasktrade.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/planning.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/label.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/report.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/reminder.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/userstory.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/profile.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="~/css/project-settings.css" asp-append-version="true" media="print" onload="this.media='all'" />
    <!-- Webpushr -->
    <form id="webpushrAntiForgeryForm" style="display:none;">
        @Html.AntiForgeryToken()
    </form>
    <script src="https://cdn.webpushr.com/app.min.js" async charset="UTF-8"></script>
    <script>
        /* Wait for SDK to load, then setup */
        function _wpSetup() {
            if (typeof webpushr === 'undefined') {
                setTimeout(_wpSetup, 200);
                return;
            }
            webpushr('setup', { 'key': '7b8acf774ea9e965e393120da0b7d643' });
        }
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            setTimeout(_wpSetup, 100);
        } else {
            document.addEventListener('DOMContentLoaded', function () { setTimeout(_wpSetup, 100); });
        }
    </script>

    <script>
        /* --- Webpushr helpers --- */
        function webpushrToken() {
            var el = document.querySelector(
                '#webpushrAntiForgeryForm input[name="__RequestVerificationToken"]');
            return el ? el.value : "";
        }

        function saveWebpushrSubscriber(sid) {
            if (!sid) return;
            var form = new FormData();
            form.append("sid", sid);
            form.append("__RequestVerificationToken", webpushrToken());
            fetch("/Account/SaveWebpushrSubscriber", {
                method: "POST",
                headers: { "X-Requested-With": "XMLHttpRequest" },
                body: form
            }).catch(function (err) {
                console.error("Failed to save Webpushr subscriber id:", err);
            });
        }

        function initWebpushrSubscription(retries) {
            retries = retries || 0;
            if (typeof webpushr === "undefined") {
                if (retries < 20) {
                    setTimeout(function () { initWebpushrSubscription(retries + 1); }, 500);
                } else {
                    console.warn("[Webpushr] SDK did not load after 10s.");
                }
                return;
            }

            if (typeof Notification !== "undefined" && Notification.permission === "default") {
                Notification.requestPermission();
            }

            webpushr('fetch_id', function (sid) {
                if (!sid) {
                    console.warn("[Webpushr] fetch_id returned null – SDK may need more time.");
                    if (retries < 10) {
                        setTimeout(function () {
                            webpushr('fetch_id', function (sid2) {
                                if (sid2) saveWebpushrSubscriber(sid2);
                            });
                        }, 2000);
                    }
                    return;
                }
                console.log("[Webpushr] SID saved:", sid);
                saveWebpushrSubscriber(sid);
            });
        }

        window.ensureWebpushrSubscription = function () {
            initWebpushrSubscription(0);
        };
    </script>

    <script>
        /* --- Webpushr diagnostic (call webpushrDiagnostic() from console) --- */
        window.webpushrDiagnostic = function () {
            var info = {
                permission: (typeof Notification !== "undefined") ? Notification.permission : "n/a",
                hasWebpushr: typeof webpushr !== "undefined",
                hasServiceWorker: typeof navigator !== "undefined" && "serviceWorker" in navigator,
                userAgent: navigator.userAgent
            };

            var done = function () {
                console.log("[Webpushr Diagnostic]", JSON.stringify(info, null, 2));
            };

            if (info.hasServiceWorker) {
                navigator.serviceWorker.getRegistrations().then(function (regs) {
                    info.serviceWorkers = regs.map(function (r) {
                        return {
                            scope: r.scope,
                            active: !!(r.active && r.active.state === "activated")
                        };
                    });
                    done();
                });
            } else {
                done();
            }

            if (typeof webpushr !== "undefined") {
                webpushr('fetch_id', function (sid) {
                    console.log("[Webpushr Diagnostic] fetch_id =>", sid);
                });
            }

            return info;
        };
    </script>

    <script>
        /* --- Auto-save SID on page load --- */
        window.addEventListener("load", function () {
            /* Give the async SDK time to load */
            setTimeout(function () {
                initWebpushrSubscription(0);
            }, 2000);
        });
    </script>

</head>

<body>

    <header class="main-header">

        <div class="header-actions">

            @await Component.InvokeAsync("Header")

            @await Component.InvokeAsync("NotificationBell")
         

        </div>       

        <div class="header-search">
            <input type="text" id="globalSearchInput" placeholder="جستجو در پروژه‌ها، تسک‌ها، اسپرینت‌ها..." autocomplete="off" />
            <i class="fa-solid fa-magnifying-glass"></i>
            <div class="search-results-dropdown" id="globalSearchResults"></div>
        </div>

        <div class="logo">
            <img width="180px" src="~/images/logo.png"></img>
        </div>

    </header>

    <div class="layout-wrapper">

        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <button class="sidebar-toggle" id="sidebarToggle" aria-label="باز/بستن منو">
                    <i class="fa-solid fa-bars"></i>
               </button>
            </div>

            <partial name="Sidebar" />

        </aside>

        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @if (isJalaliDate)
    {
        <script src="https://cdn.jsdelivr.net/npm/persian-date@latest/dist/persian-date.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/persian-datepicker@latest/dist/js/persian-datepicker.min.js"></script>
        <script src="~/js/date-picker-init.js" asp-append-version="true"></script>
    }

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/node_modules/sweet-scroll/sweet-scroll.min.js" asp-append-version="true"></script>
    <script src="~/node_modules/@@popperjs/core/dist/umd/popper.min.js"></script>
    <script src="~/node_modules/tippy.js/dist/tippy-bundle.umd.min.js"></script>

    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>
    <script src="~/js/GlobalSearch.js" asp-append-version="true"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            showSuccess('@Html.Raw(TempData["Success"])');
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            showError('@Html.Raw(TempData["Error"])');
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            showWarning('@TempData["Warning"]');
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
