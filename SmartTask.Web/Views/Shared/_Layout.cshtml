<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - SmartTask</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/notification.css" asp-append-version="true" />

</head>

<body>

    <header class="main-header">

        <div class="header-actions">

            @await Component.InvokeAsync("NotificationBell")

            @await Component.InvokeAsync("Header")

            <button class="icon-btn">
                <i class="fa-regular fa-bell"></i>
            </button>

            <button class="icon-btn">
                <i class="fa-regular fa-envelope"></i>
            </button>

        </div>       

        <div class="header-search">
            <input type="text" placeholder="جستجو..." />
            <i class="fa fa-search"></i>
        </div>

        <div class="logo">
            <span>SmartTask</span>
            <div class="logo-icon">
                <i class="fa-solid fa-bolt"></i>
            </div>          
        </div>

    </header>

    <div class="layout-wrapper">

        <aside class="sidebar" id="sidebar">

            <div class="sidebar-header">
                <button class="sidebar-toggle" id="sidebarToggle">
                    <i class="fa-solid fa-bars"></i>
               </button>
            </div>

            <partial name="Sidebar" />

        </aside>

        <main class="content-area">
            @RenderBody()
        </main>

    </div>

    @await Component.InvokeAsync("Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script src="~/js/site.js"></script>

    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/notification.js" asp-append-version="true"></script>

    @if (TempData["Success"] != null)
    {
        <script>
            showSuccess('@Html.Raw(TempData["Success"])');
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            showError('@Html.Raw(TempData["Error"])');
        </script>
    }

    @if (TempData["Warning"] != null)
    {
        <script>
            showWarning('@TempData["Warning"]');
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>
