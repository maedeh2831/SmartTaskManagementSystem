@using SmartTask.Web.Models
@using SmartTask.Web.Models.Enums
@using SmartTask.Web.Models.Navigation
@using SmartTask.Web.Infrastructure.Interfaces
@using SmartTask.Web.Services.Interfaces
@inject ICurrentContextService CurrentContext
@inject ICurrentUserService CurrentUser
@inject IChatService ChatService
@{
    var controllerName = ViewContext.RouteData.Values["Controller"]?.ToString();
    var menus = SidebarMenu.Items
        .Where(x => string.IsNullOrEmpty(x.RequiredRole) || User.IsInRole(x.RequiredRole))
        .ToList();

    // نشان پیام‌های خوانده‌نشده روی منوی گفتگو
    if (CurrentUser.IsAuthenticated)
    {
        var unread = await ChatService.GetTotalUnreadCountAsync(CurrentUser.UserId);

        if (unread > 0)
        {
            var chatItem = menus.FirstOrDefault(x => x.Controller == "Chat");
            if (chatItem != null)
                chatItem.Badge = unread > 99 ? "99+" : unread.ToString();
        }
    }

    var groups = menus.GroupBy(x => x.Category);

    bool IsLocked(SidebarItem item) =>
        (item.RequiresContext == ContextRequirementType.Workspace && CurrentContext.CurrentWorkspaceId == null)
        || (item.RequiresContext == ContextRequirementType.Project && CurrentContext.CurrentProjectId == null);
}

<ul class="sidebar-menu">
    @foreach (var group in groups)
    {
        <li class="sidebar-category">@group.Key</li>

        @foreach (var item in group)
        {
            var hasChildren = item.Children != null && item.Children.Any();
            var isActive = !hasChildren && controllerName == item.Controller;
            var isLocked = IsLocked(item);

            if (hasChildren)
            {
                var isChildActive = item.Children.Any(c => c.Controller == controllerName);
                <li class="has-children @(isChildActive ? "open" : "") @(isLocked ? "disabled" : "")">
                    <a href="#" class="sidebar-parent-link" onclick="return SmartTask.toggleSidebarGroup(this);" title="@item.Title">
                        <i class="@item.Icon"></i>
                        <span>@item.Title</span>
                        <i class="fa-solid fa-chevron-down submenu-arrow"></i>
                    </a>
                    <ul class="sidebar-submenu">
                        @foreach (var child in item.Children)
                        {
                            var childActive = controllerName == child.Controller;
                            var childLocked = IsLocked(child);
                            <li class="@(childActive ? "active" : "") @(childLocked ? "disabled" : "")">
                                @if (childLocked)
                                {
                                    <a href="#" onclick="return false;" title="ابتدا یک پروژه انتخاب کنید">
                                        <i class="@child.Icon"></i>
                                        <span>@child.Title</span>
                                        <i class="fa-solid fa-lock menu-lock-icon"></i>
                                    </a>
                                }
                                else if (child.RequiresContext == ContextRequirementType.Project)
                                {
                                    <a asp-controller="@child.Controller" asp-action="@child.Action" asp-route-projectId="@CurrentContext.CurrentProjectId" title="@child.Title">
                                        <i class="@child.Icon"></i>
                                        <span>@child.Title</span>
                                    </a>
                                }
                                else if (child.RequiresContext == ContextRequirementType.Workspace)
                                {
                                    <a asp-controller="@child.Controller" asp-action="@child.Action" asp-route-workspaceId="@CurrentContext.CurrentWorkspaceId" title="@child.Title">
                                        <i class="@child.Icon"></i>
                                        <span>@child.Title</span>
                                    </a>
                                }
                                else
                                {
                                    <a asp-controller="@child.Controller" asp-action="@child.Action" title="@child.Title">
                                        <i class="@child.Icon"></i>
                                        <span>@child.Title</span>
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                </li>
            }
            else
            {
                <li class="@(isActive ? "active" : "") @(isLocked ? "disabled" : "")">
                    @if (isLocked)
                    {
                        <a href="#" class="sidebar-locked-link"
                           title="ابتدا یک @(item.RequiresContext == ContextRequirementType.Workspace ? "فضای کاری" : "پروژه") انتخاب کنید"
                           onclick="return false;">
                            <i class="@item.Icon"></i>
                            <span>@item.Title</span>
                            <i class="fa-solid fa-lock menu-lock-icon"></i>
                        </a>
                    }
                    else if (item.RequiresContext == ContextRequirementType.Workspace)
                    {
                        <a asp-controller="@item.Controller" asp-action="@item.Action" asp-route-workspaceId="@CurrentContext.CurrentWorkspaceId" title="@item.Title">
                            <i class="@item.Icon"></i>
                            <span>@item.Title</span>
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <span class="menu-badge">@item.Badge</span>
                            }
                        </a>
                    }
                    else if (item.RequiresContext == ContextRequirementType.Project)
                    {
                        <a asp-controller="@item.Controller" asp-action="@item.Action" asp-route-projectId="@CurrentContext.CurrentProjectId" title="@item.Title">
                            <i class="@item.Icon"></i>
                            <span>@item.Title</span>
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <span class="menu-badge">@item.Badge</span>
                            }
                        </a>
                    }
                    else
                    {
                        <a asp-controller="@item.Controller" asp-action="@item.Action" title="@item.Title">
                            <i class="@item.Icon"></i>
                            <span>@item.Title</span>
                            @if (!string.IsNullOrEmpty(item.Badge))
                            {
                                <span class="menu-badge">@item.Badge</span>
                            }
                        </a>
                    }
                </li>
            }
        }
    }
</ul>