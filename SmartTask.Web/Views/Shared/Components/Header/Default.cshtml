@model SmartTask.Web.Models.ViewModels.Shared.HeaderViewModel
@{
    var cosmetics = Model.Cosmetics;
    var borderColor = cosmetics?.AvatarBorderColor;
    var hasBorder = !string.IsNullOrWhiteSpace(borderColor);
    var borderRarity = cosmetics?.AvatarBorderRarity ?? 0;
}

<div class="dropdown">

    <button class="user-menu"
            data-bs-toggle="dropdown">

        <div class="user-avatar @(hasBorder ? "has-equipped-border" : "") @(borderRarity >= 5 ? "border-legendary" : "")"
             @(hasBorder ? $"style=--equipped-border-color:{borderColor}" : "")
             @(hasBorder ? $"title={cosmetics!.AvatarBorderName}" : "")>

            <img src="@Model.AvatarUrl"
                 alt="@Model.FullName"
                 class="user-avatar-image" />

            @if (!string.IsNullOrWhiteSpace(cosmetics?.BadgeIcon))
            {
                <span class="user-avatar-badge" title="@cosmetics.BadgeName">@cosmetics.BadgeIcon</span>
            }

        </div>

        <div class="text-end">

            <div class="user-name fw-bold">
                @Model.FullName
            </div>

        </div>

        <i class="fa-solid fa-chevron-down small-arrow"></i>

    </button>

    <ul class="dropdown-menu dropdown-menu-end">

        <!-- اطلاعات کاربر -->
        <li class="px-3 py-2">

            <div class="fw-bold">
                @Model.FullName
            </div>

            <small class="text-muted">
                @Model.Email
            </small>

        </li>

        <li><hr class="dropdown-divider"></li>

        <!-- پروفایل -->
        <li>
            <a asp-controller="Account"
               asp-action="Profile"
               class="dropdown-item">

                <i class="fa-regular fa-user"></i>

                <span>پروفایل من</span>

            </a>
        </li>

        <!-- تنظیمات -->
        <li>
            <a asp-controller="Settings"
               asp-action="Index"
               class="dropdown-item">
                <i class="fa-solid fa-gear"></i>
                تنظیمات
            </a>
        </li>

        <li><hr class="dropdown-divider"></li>

        <!-- خروج -->
        <li>
            <form id="logoutForm"
                  asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="button"
                        id="logoutButton"
                        class="dropdown-item text-danger">

                    <i class="fa-solid fa-right-from-bracket"></i>

                    خروج

                </button>

            </form>
        </li>

    </ul>

</div>