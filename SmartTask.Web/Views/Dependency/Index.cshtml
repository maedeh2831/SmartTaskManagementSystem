@model SmartTask.Web.Models.ViewModels.Dependency.DependencyRiskIndexViewModel

@{
    ViewData["Title"] = "ریسک وابستگی‌ها";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/project.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/dependency.css" asp-append-version="true" />
}

<div class="workspace-container">

    <div class="workspace-hero">
        <div class="workspace-hero-content">
            <h1><i class="fa-solid fa-diagram-project"></i> تحلیل ریسک وابستگی — @Model.ProjectName</h1>
            <p>Task هایی که تأخیرشان روی سایر بخش‌های پروژه اثر مستقیم می‌گذارد.</p>
        </div>

        <div class="workspace-toolbar">
            <a asp-controller="Project" asp-action="Details" asp-route-id="@Model.ProjectId" class="workspace-filter" style="text-decoration:none;">
                <button type="button">
                    <i class="fa-solid fa-arrow-right"></i>
                    بازگشت به پروژه
                </button>
            </a>
        </div>
    </div>

    @if (!Model.RiskyTasks.Any())
    {
        <div class="workspace-empty">
            <i class="fa-solid fa-circle-check"></i>
            <h3>در حال حاضر هیچ ریسک زنجیره‌ای شناسایی نشد.</h3>
            <p>هیچ Task عقب‌افتاده‌ای وجود ندارد که روی Task دیگری تأثیر بگذارد.</p>
        </div>
    }
    else
    {
        <div class="dependency-risk-list">
            @foreach (var risk in Model.RiskyTasks)
            {
                <div class="dependency-risk-card">

                    <div class="dependency-risk-header">
                        <div>
                            <h4><a asp-controller="Task" asp-action="Details" asp-route-id="@risk.TaskId">@risk.Title</a></h4>
                            <span class="dependency-risk-delay">@risk.DelayDays روز تأخیر</span>
                        </div>
                        <span class="dependency-risk-count">
                            @risk.ImpactedTaskCount Task متأثر
                        </span>
                    </div>

                    <div class="dependency-risk-chips">
                        @foreach (var title in risk.ImpactedTaskTitles)
                        {
                            <span class="team-project-chip">@title</span>
                        }
                        @if (risk.ImpactedTaskCount > risk.ImpactedTaskTitles.Count)
                        {
                            <span class="team-project-chip">+@(risk.ImpactedTaskCount - risk.ImpactedTaskTitles.Count) مورد دیگر</span>
                        }
                    </div>

                </div>
            }
        </div>
    }

</div>