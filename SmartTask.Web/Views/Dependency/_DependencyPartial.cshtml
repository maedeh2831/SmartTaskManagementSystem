@model SmartTask.Web.Models.ViewModels.Dependency.DependencyRiskIndexViewModel

<style>
    .redirect-card { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 60px 24px; text-align: center; background: var(--card); border: 1px solid var(--gray200); border-radius: 12px; }
    .redirect-icon { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; border-radius: 16px; background: var(--primary-light); color: var(--primary); font-size: 24px; margin-bottom: 18px; }
    .redirect-card h3 { margin: 0 0 8px; font-size: 18px; font-weight: 700; color: var(--gray800); }
    .redirect-card p { margin: 0 0 20px; color: var(--gray500); font-size: 13px; line-height: 1.8; }
    .redirect-btn { display: inline-flex; align-items: center; gap: 8px; padding: 11px 22px; border: none; border-radius: 10px; background: var(--primary); color: #fff; font-family: inherit; font-size: 14px; font-weight: 700; cursor: pointer; text-decoration: none; box-shadow: 0 2px 6px rgba(91,95,239,.18); transition: background .2s ease, transform .15s ease; }
    .redirect-btn:hover { background: var(--primary-dark); transform: translateY(-1px); }
</style>

<div class="redirect-card">
    <div class="redirect-icon"><i class="fa-solid fa-diagram-project"></i></div>
    <h3>تحلیل ریسک وابستگی</h3>
    <p>نمودار گرافی وابستگی تسک‌ها و شناسایی زنجیره‌های پرریسک.</p>
    <a href="/Dependency/Index?projectId=@Model.ProjectId" class="redirect-btn" target="_blank">
        <i class="fa-solid fa-arrow-up-right-from-square"></i>
        باز کردن وابستگی
    </a>
</div>
