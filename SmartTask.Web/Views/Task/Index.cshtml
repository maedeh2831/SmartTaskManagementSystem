@model SmartTask.Web.Models.ViewModels.Task.TaskIndexViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "تسک‌های " + Model.UserStoryTitle;
}
@inject SmartTask.Web.Services.Interfaces.IDateFormatService DateFormatService
@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/backlog.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/task.css" asp-append-version="true" />
}

<div class="workspace-container">

    <div class="workspace-hero task-page-hero">

        <div class="workspace-hero-content">

            <div class="task-page-title-row">

                <div class="task-page-title">

                    <div class="task-page-icon">
                        <i class="fa-solid fa-list-check"></i>
                    </div>

                    <div>
                        <h1>تسک‌های «@Model.UserStoryTitle»</h1>
                        <p>مدیریت وظایف اجرایی این User Story به‌صورت Kanban.</p>
                    </div>

                </div>

                <a asp-controller="UserStory"
                   asp-action="Details"
                   asp-route-id="@Model.UserStoryId"
                   class="task-story-back">

                    <i class="fa-solid fa-arrow-right"></i>

                    <span>بازگشت به Story</span>

                </a>

            </div>

        </div>

        @if (Model.CanManage)
        {
            <div class="task-page-actions">

                <button type="button"
                        class="task-create-trigger"
                        data-task-modal-open>

                    <i class="fa-solid fa-plus"></i>

                    <span>Task جدید</span>

                </button>

            </div>
        }

    </div>

    @if (!Model.Tasks.Any())
    {
        <div class="workspace-empty">
            <i class="fa-solid fa-list-check"></i>
            <h3>هنوز Task ای برای این Story ثبت نشده است.</h3>
            <p>اولین Task اجرایی این Story را ایجاد کنید.</p>
        </div>
    }
    else
    {
        <div class="task-kanban" id="taskKanban">

            @{
                var columns = new[]
                {
                (Status: TaskStatusType.ToDo, Label: "برای انجام", Icon: "fa-circle"),
                (Status: TaskStatusType.InProgress, Label: "درحال انجام", Icon: "fa-spinner"),
                (Status: TaskStatusType.InReview, Label: "درحال بررسی", Icon: "fa-magnifying-glass"),
                (Status: TaskStatusType.Done, Label: "انجام‌شده", Icon: "fa-circle-check"),
                (Status: TaskStatusType.Cancelled, Label: "لغو‌شده", Icon: "fa-circle-xmark")
                };
            }

            @foreach (var col in columns)
            {
                var columnTasks = Model.Tasks.Where(x => x.Status == col.Status).ToList();

                <div class="task-column">
                    <div class="task-column-header status-@col.Status.ToString().ToLower()">
                        <i class="fa-solid @col.Icon"></i>
                        @col.Label
                        <span class="planning-count">@columnTasks.Count</span>
                    </div>

                    <div class="task-list"
                         data-status="@((int)col.Status)"
                         data-can-manage="@Model.CanManage.ToString().ToLower()">

                        @foreach (var task in columnTasks)
                        {
                            <div class="task-card" draggable="@(Model.CanManage ? "true" : "false")" data-id="@task.Id" data-title="@task.Title">

                                @if (Model.CanManage)
                                {
                                    <i class="fa-solid fa-grip-vertical task-drag-handle"></i>
                                }

                            <div class="task-card-body">
                                <a asp-action="Details" asp-route-id="@task.Id" class="task-card-title">
                                    @task.Title
                                </a>

                                <div class="task-card-meta">
                                    <span class="task-type-badge type-@task.Type.ToString().ToLower()">
                                        @(task.Type switch
                                        {
                                            TaskType.Task => "Task",
                                            TaskType.Bug => "Bug",
                                            TaskType.Feature => "Feature",
                                            TaskType.Improvement => "بهبود",
                                            TaskType.TechnicalDebt => "بدهی فنی",
                                            _ => "-"
                                        })
                            </span>
                            <span class="backlog-priority-badge priority-@task.Priority.ToString().ToLower()">
                                @task.Priority
                            </span>
                        </div>

                        @if (task.Estimate > 0 || task.DueDate.HasValue)
                                    {
                                        <div class="task-card-footer">
                                            @if (task.Estimate > 0)
                                            {
                                                <span><i class="fa-regular fa-clock"></i> @task.Estimate ساعت</span>
                                            }
                                            @if (task.DueDate.HasValue)
                                            {
                                                <span><i class="fa-regular fa-calendar"></i> @DateFormatService.ToShortDisplayString(task.DueDate.Value)</span>
                                            }
                                        </div>
                                    }
                                </div>

                            </div>
                        }

                    </div>
                </div>
            }

        </div>
    }

</div>

@if (Model.CanManage)
{
    @await Html.PartialAsync(
    "_CreateTaskModal",
        new SmartTask.Web.Models.ViewModels.Task.CreateTaskViewModel
        {
            UserStoryId = Model.UserStoryId
        })
}

<form id="antiForgeryForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <script src="~/js/task.js" asp-append-version="true"></script>
}