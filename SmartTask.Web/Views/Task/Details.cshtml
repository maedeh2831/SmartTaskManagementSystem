@model SmartTask.Web.Models.ViewModels.Task.TaskDetailsViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "جزئیات Task";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/task.css" asp-append-version="true" />
}

<div class="workspace-details-page">

    <div class="page-header">
        <div>
            <h1>
                @Model.Title
                <span class="backlog-status-badge task-status-badge status-@Model.Status.ToString().ToLower()">
                    @(Model.Status switch
                    {
                        TaskStatusType.ToDo => "برای انجام",
                        TaskStatusType.InProgress => "درحال انجام",
                        TaskStatusType.InReview => "درحال بررسی",
                        TaskStatusType.Done => "انجام‌شده",
                        TaskStatusType.Cancelled => "لغو‌شده",
                        _ => "-"
                    })
                </span>
            </h1>
            <p>User Story: @Model.UserStoryTitle — پروژه: @Model.ProjectName</p>
        </div>

        <div style="display:flex;gap:10px;">

            <a asp-action="Index" asp-route-userStoryId="@Model.UserStoryId" class="back-link">
                <i class="fa-solid fa-arrow-right"></i>
                بازگشت
            </a>

            @if (Model.CanManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light">
                    <i class="fa-solid fa-pen-to-square"></i>
                    ویرایش
                </a>
            }

        </div>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-align-right"></i>
            توضیحات
        </div>
        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "توضیحاتی ثبت نشده است." : Model.Description)</p>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-gauge-high"></i>
            اطلاعات Task
        </div>

        <div class="userstory-info-grid">
            <div>
                <span class="userstory-info-label">نوع</span>
                <span class="task-type-badge type-@Model.Type.ToString().ToLower()">@Model.Type</span>
            </div>
            <div>
                <span class="userstory-info-label">اولویت</span>
                <span class="backlog-priority-badge priority-@Model.Priority.ToString().ToLower()">@Model.Priority</span>
            </div>
            <div>
                <span class="userstory-info-label">برآورد</span>
                <span>@Model.Estimate ساعت</span>
            </div>
            <div>
                <span class="userstory-info-label">تاریخ شروع</span>
                <span>@(Model.StartDate?.ToString("yyyy/MM/dd") ?? "—")</span>
            </div>
            <div>
                <span class="userstory-info-label">موعد انجام</span>
                <span>@(Model.DueDate?.ToString("yyyy/MM/dd") ?? "—")</span>
            </div>
            @if (Model.CompletedDate.HasValue)
            {
                <div>
                    <span class="userstory-info-label">تاریخ تکمیل</span>
                    <span>@Model.CompletedDate.Value.ToString("yyyy/MM/dd")</span>
                </div>
            }
        </div>
    </div>

    <!-- ===== 👇 بخش جدید: افراد تخصیص‌یافته (Story 3) ===== -->
    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-users"></i>
            افراد تخصیص‌یافته
        </div>

        @if (!Model.Assignees.Any())
        {
            <div class="team-empty-text">هنوز کسی به این Task تخصیص نیافته است.</div>
        }
        else
        {
            <div class="assignee-list">
                @foreach (var assignee in Model.Assignees)
                {
                    <div class="assignee-chip">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>@assignee.FullName</span>

                        @if (Model.CanManage)
                        {
                            <form asp-controller="TaskAssignment" asp-action="RemoveMember" method="post" class="assignee-remove-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <input type="hidden" name="userId" value="@assignee.UserId" />
                                <button type="submit" title="حذف تخصیص">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.CanManage && Model.AvailableMembers.Any())
        {
            <form asp-controller="TaskAssignment" asp-action="AssignMember" method="post" class="assignee-add-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <select name="userId" class="form-control" required>
                    <option value="">— انتخاب عضو برای تخصیص —</option>
                    @foreach (var member in Model.AvailableMembers)
                    {
                        <option value="@member.UserId">@member.FullName</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-user-plus"></i>
                    تخصیص
                </button>
            </form>
        }
    </div>
    <!-- ===== 👆 پایان بخش افراد تخصیص‌یافته ===== -->
    <!-- ===== 👇 بخش SubTask (Story 2) ===== -->
    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-list-check"></i>
            SubTask ها
            @if (Model.SubTasksTotal > 0)
            {
                <span class="subtask-progress-text">(@Model.SubTasksCompleted از @Model.SubTasksTotal)</span>
            }
        </div>

        @if (Model.SubTasksTotal > 0)
        {
            <div class="subtask-progress-track">
                <div class="subtask-progress-fill" style="width:@Model.SubTasksProgressPercent%"></div>
            </div>
        }

        @if (!Model.SubTasks.Any())
        {
            <div class="team-empty-text">هنوز SubTask ای برای این Task ثبت نشده است.</div>
        }
        else
        {
            <div class="subtask-list">
                @foreach (var sub in Model.SubTasks)
                {
                    <div class="subtask-item @(sub.IsCompleted ? "completed" : "")" data-id="@sub.Id">

                        <label class="subtask-checkbox-wrap">
                            <input type="checkbox"
                                   class="subtask-toggle"
                                   data-id="@sub.Id"
                                   data-task-id="@Model.Id"
                                   checked="@sub.IsCompleted"
                                   disabled="@(!Model.CanManage)" />
                            <span class="subtask-title">@sub.Title</span>
                        </label>

                        @if (Model.CanManage)
                        {
                            <form asp-controller="SubTask" asp-action="Delete" method="post" class="delete-subtask-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@sub.Id" />
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <button type="submit" class="subtask-delete-btn">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </form>
                        }

                    </div>
                }
            </div>
        }

        @if (Model.CanManage)
        {
            <form asp-controller="SubTask" asp-action="QuickAdd" method="post" class="subtask-quick-add">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <i class="fa-solid fa-plus"></i>
                <input type="text" name="title" placeholder="افزودن SubTask جدید... (Enter بزنید)" required maxlength="250" />
                <button type="submit">افزودن</button>
            </form>
        }
    </div>
    <!-- ===== 👆 پایان بخش SubTask ===== -->
    @if (Model.CanManage)
    {
        <div class="details-card">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="delete-task-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash"></i>
                    حذف Task
                </button>
            </form>
        </div>
    }

</div>

@section Scripts
{
    <script src="~/js/task.js" asp-append-version="true"></script>
}