@model SmartTask.Web.Models.ViewModels.Task.TaskDetailsViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "جزئیات Task";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/team.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/task.css" asp-append-version="true" />
}

<div class="workspace-details-page">

    <div class="page-header">
        <div>
            <h1>
                @Model.Title
                <span class="backlog-status-badge task-status-badge status-@Model.Status.ToString().ToLower()">
                    @(Model.Status switch
                    {
                        TaskStatusType.ToDo => "برای انجام",
                        TaskStatusType.InProgress => "درحال انجام",
                        TaskStatusType.InReview => "درحال بررسی",
                        TaskStatusType.Done => "انجام‌شده",
                        TaskStatusType.Cancelled => "لغو‌شده",
                        _ => "-"
                    })
                </span>
            </h1>
            <p>User Story: @Model.UserStoryTitle — پروژه: @Model.ProjectName</p>
        </div>

        <div style="display:flex;gap:10px;">
            <a asp-action="Index" asp-route-userStoryId="@Model.UserStoryId" class="back-link">
                <i class="fa-solid fa-arrow-right"></i>
                بازگشت
            </a>

            @if (Model.CanManage)
            {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-light">
                    <i class="fa-solid fa-pen-to-square"></i>
                    ویرایش
                </a>
            }
        </div>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-align-right"></i>
            توضیحات
        </div>
        <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "توضیحاتی ثبت نشده است." : Model.Description)</p>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-gauge-high"></i>
            اطلاعات Task
        </div>

        <div class="userstory-info-grid">
            <div>
                <span class="userstory-info-label">نوع</span>
                <span class="task-type-badge type-@Model.Type.ToString().ToLower()">@Model.Type</span>
            </div>
            <div>
                <span class="userstory-info-label">اولویت</span>
                <span class="backlog-priority-badge priority-@Model.Priority.ToString().ToLower()">@Model.Priority</span>
            </div>
            <div>
                <span class="userstory-info-label">برآورد</span>
                <span>@Model.Estimate ساعت</span>
            </div>
            <div>
                <span class="userstory-info-label">تاریخ شروع</span>
                <span>@(Model.StartDate?.ToString("yyyy/MM/dd") ?? "—")</span>
            </div>
            <div>
                <span class="userstory-info-label">موعد انجام</span>
                <span>@(Model.DueDate?.ToString("yyyy/MM/dd") ?? "—")</span>
            </div>
            @if (Model.CompletedDate.HasValue)
            {
                <div>
                    <span class="userstory-info-label">تاریخ تکمیل</span>
                    <span>@Model.CompletedDate.Value.ToString("yyyy/MM/dd")</span>
                </div>
            }
        </div>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-stopwatch"></i>
            ثبت زمان
            <span class="subtask-progress-text">(مجموع: @Model.TotalLoggedDisplay)</span>
        </div>

        @if (Model.MyActiveTimer != null)
        {
            <div class="timer-active-box">
                <div class="timer-live-display" id="liveTimer" data-start="@Model.MyActiveTimer.StartTime.ToString("o")">
                    ۰۰:۰۰:۰۰
                </div>

                <form asp-controller="TimeLog" asp-action="Stop" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.MyActiveTimer.Id" />
                    <input type="hidden" name="taskItemId" value="@Model.Id" />
                    <button type="submit" class="btn btn-danger">
                        <i class="fa-solid fa-stop"></i>
                        توقف تایمر
                    </button>
                </form>
            </div>
        }
        else
        {
            <form asp-controller="TimeLog" asp-action="Start" method="post" class="timer-start-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-play"></i>
                    شروع تایمر
                </button>
            </form>
        }

        @if (Model.CanManage)
        {
            <form asp-controller="TimeLog" asp-action="AddManual" method="post" class="manual-timelog-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />

                <div class="manual-timelog-fields">
                    <input type="datetime-local" name="startTime" class="form-control" required />
                    <input type="number" name="durationMinutes" min="1" max="1440" placeholder="مدت (دقیقه)" class="form-control" required />
                    <input type="text" name="description" placeholder="توضیح (اختیاری)" class="form-control" />
                    <button type="submit" class="btn btn-light">
                        <i class="fa-solid fa-plus"></i>
                        ثبت دستی
                    </button>
                </div>
            </form>
        }

        @if (!Model.TimeLogs.Any())
        {
            <div class="team-empty-text">هنوز زمانی برای این Task ثبت نشده است.</div>
        }
        else
        {
            <div class="timelog-list">
                @foreach (var log in Model.TimeLogs)
                {
                    <div class="timelog-item">
                        <i class="fa-regular fa-clock"></i>
                        <div class="timelog-info">
                            <span class="timelog-user">
                                @log.UserName
                                @if (log.IsRunning)
                                {
                                    <span class="timelog-running-badge">درحال اجرا</span>
                                }
                            </span>
                            <span class="timelog-meta">
                                @log.StartTime.ToString("yyyy/MM/dd HH:mm")
                                @if (!log.IsRunning)
                                {
                                    <text> — @(log.DurationMinutes) دقیقه</text>
                                }
                                @if (!string.IsNullOrWhiteSpace(log.Description))
                                {
                                    <text> — @log.Description</text>
                                }
                            </span>
                        </div>

                        @if (log.CanDelete && !log.IsRunning)
                        {
                            <form asp-controller="TimeLog" asp-action="Delete" method="post" class="delete-timelog-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@log.Id" />
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <button type="submit" class="subtask-delete-btn"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </div>
                }
            </div>
        }
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-tags"></i>
            Label ها
        </div>

        <div class="label-badge-list">
            @if (!Model.Labels.Any())
            {
                <span class="team-empty-text">هیچ Label ای به این Task اضافه نشده است.</span>
            }
            else
            {
                @foreach (var label in Model.Labels)
                {
                    <span class="task-label-badge" style="background:@label.Color">
                        @label.Name

                        @if (Model.CanManage)
                        {
                            <form asp-controller="TaskLabel" asp-action="Remove" method="post" class="label-remove-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <input type="hidden" name="labelId" value="@label.Id" />
                                <button type="submit"><i class="fa-solid fa-xmark"></i></button>
                            </form>
                        }
                    </span>
                }
            }
        </div>

        @if (Model.CanManage && Model.AvailableLabels.Any())
        {
            <form asp-controller="TaskLabel" asp-action="Assign" method="post" class="label-assign-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <select name="labelId" class="form-control" required>
                    <option value="">— انتخاب Label برای افزودن —</option>
                    @foreach (var label in Model.AvailableLabels)
                    {
                        <option value="@label.Id">@label.Name</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    افزودن
                </button>
            </form>
        }

        <a asp-controller="Label" asp-action="Index" asp-route-projectId="@Model.ProjectId" class="label-manage-link">
            <i class="fa-solid fa-gear"></i>
            مدیریت Label های پروژه
        </a>
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-users"></i>
            افراد تخصیص‌یافته
        </div>

        @if (!Model.Assignees.Any())
        {
            <div class="team-empty-text">هنوز کسی به این Task تخصیص نیافته است.</div>
        }
        else
        {
            <div class="assignee-list">
                @foreach (var assignee in Model.Assignees)
                {
                    <div class="assignee-chip">
                        <i class="fa-regular fa-circle-user"></i>
                        <span>@assignee.FullName</span>

                        @if (Model.CanManage)
                        {
                            <form asp-controller="TaskAssignment" asp-action="RemoveMember" method="post" class="assignee-remove-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <input type="hidden" name="userId" value="@assignee.UserId" />
                                <button type="submit" title="حذف تخصیص">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.CanManage && Model.AvailableMembers.Any())
        {
            <form asp-controller="TaskAssignment" asp-action="AssignMember" method="post" class="assignee-add-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <select name="userId" class="form-control" required>
                    <option value="">— انتخاب عضو برای تخصیص —</option>
                    @foreach (var member in Model.AvailableMembers)
                    {
                        <option value="@member.UserId">@member.FullName</option>
                    }
                </select>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-user-plus"></i>
                    تخصیص
                </button>
            </form>
        }
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-list-check"></i>
            Checklist ها
        </div>

        @if (!Model.Checklists.Any())
        {
            <div class="team-empty-text">هنوز Checklist ای برای این Task ثبت نشده است.</div>
        }
        else
        {
            @foreach (var checklist in Model.Checklists)
            {
                <div class="checklist-block">
                    <div class="checklist-header">
                        <span class="checklist-title">@checklist.Title</span>
                        <span class="subtask-progress-text">(@checklist.CompletedItems از @checklist.TotalItems)</span>

                        @if (Model.CanManage)
                        {
                            <form asp-controller="Checklist" asp-action="Delete" method="post" class="delete-checklist-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@checklist.Id" />
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <button type="submit" class="subtask-delete-btn"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </div>

                    @if (checklist.TotalItems > 0)
                    {
                        <div class="subtask-progress-track">
                            <div class="subtask-progress-fill" style="width:@checklist.ProgressPercent%"></div>
                        </div>
                    }

                    <div class="subtask-list">
                        @foreach (var item in checklist.Items)
                        {
                            <div class="subtask-item @(item.IsCompleted ? "completed" : "")" data-id="@item.Id">
                                <label class="subtask-checkbox-wrap">
                                    <input type="checkbox" class="checklist-item-toggle" data-id="@item.Id"
                                           checked="@item.IsCompleted" disabled="@(!Model.CanManage)" />
                                    <span class="subtask-title">@item.Title</span>
                                </label>

                                @if (Model.CanManage)
                                {
                                    <form asp-controller="Checklist" asp-action="DeleteItem" method="post" class="delete-checklist-item-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <input type="hidden" name="taskItemId" value="@Model.Id" />
                                        <button type="submit" class="subtask-delete-btn"><i class="fa-solid fa-xmark"></i></button>
                                    </form>
                                }
                            </div>
                        }
                    </div>

                    @if (Model.CanManage)
                    {
                        <form asp-controller="Checklist" asp-action="AddItem" method="post" class="subtask-quick-add">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="checklistId" value="@checklist.Id" />
                            <input type="hidden" name="taskItemId" value="@Model.Id" />
                            <i class="fa-solid fa-plus"></i>
                            <input type="text" name="title" placeholder="افزودن آیتم جدید..." required maxlength="250" />
                            <button type="submit">افزودن</button>
                        </form>
                    }
                </div>
            }
        }

        @if (Model.CanManage)
        {
            <form asp-controller="Checklist" asp-action="Create" method="post" class="checklist-create-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <i class="fa-solid fa-plus"></i>
                <input type="text" name="title" placeholder="افزودن Checklist جدید... (مثلاً: مراحل تست)" required maxlength="200" />
                <button type="submit">ایجاد Checklist</button>
            </form>
        }
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-diagram-project"></i>
            وابستگی‌ها
        </div>

        @if (Model.CascadeInfo.Any())
        {
            <div class="cascade-info-box">
                <i class="fa-solid fa-arrows-rotate"></i>
                <div>
                    <strong>موعد این Task به‌صورت خودکار تمدید شده است.</strong>
                    <ul>
                        @foreach (var info in Model.CascadeInfo)
                        {
                            <li>
                                به‌دلیل تأخیر <strong>@info.DelayDaysApplied روزه</strong> در
                                <a asp-action="Details" asp-route-id="@info.SourceTaskId">«@info.SourceTaskTitle»</a>
                                — آخرین به‌روزرسانی: @info.AppliedDate.ToString("yyyy/MM/dd HH:mm")
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        @if (Model.Dependency.DelayDays > 0)
        {
            <div class="dependency-alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                این Task <strong>@Model.Dependency.DelayDays روز</strong> از موعدش گذشته.
                @if (Model.Dependency.ImpactedTasks.Any(x => x.IsRequiredChain))
                {
                    <text> این تأخیر روی <strong>@Model.Dependency.ImpactedTasks.Count(x => x.IsRequiredChain) Task دیگر</strong> تأثیر مستقیم دارد.</text>
                }
            </div>
        }

        <div class="dependency-columns">

            <div class="dependency-column">
                <h5><i class="fa-solid fa-arrow-left-long"></i> این Task به این‌ها وابسته است</h5>

                @if (!Model.Dependency.DependsOn.Any())
                {
                    <p class="team-empty-text">وابستگی‌ای ثبت نشده است.</p>
                }
                else
                {
                    @foreach (var dep in Model.Dependency.DependsOn)
                    {
                        <div class="dependency-chip">
                            <a asp-action="Details" asp-route-id="@dep.TaskId">@dep.TaskTitle</a>
                            <span class="task-status-badge status-@dep.TaskStatus.ToString().ToLower()">@dep.TaskStatus</span>
                            @if (!dep.IsRequired)
                            {
                                <span class="dependency-optional-badge">اختیاری</span>
                            }

                            @if (Model.Dependency.CanManage)
                            {
                                <form asp-controller="TaskDependency" asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@dep.Id" />
                                    <input type="hidden" name="taskItemId" value="@Model.Id" />
                                    <button type="submit" class="delete-dependency-btn"><i class="fa-solid fa-xmark"></i></button>
                                </form>
                            }
                        </div>
                    }
                }

                @if (Model.Dependency.CanManage && Model.Dependency.AvailableTasks.Any())
                {
                    <form asp-controller="TaskDependency" asp-action="Add" method="post" class="dependency-add-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="taskItemId" value="@Model.Id" />

                        <select name="dependsOnTaskId" class="form-control" required>
                            <option value="">— انتخاب Task —</option>
                            @foreach (var t in Model.Dependency.AvailableTasks)
                            {
                                <option value="@t.Value">@t.Text</option>
                            }
                        </select>

                        <label class="dependency-required-check">
                            <input type="checkbox" name="isRequired" value="true" checked />
                            وابستگی اجباری
                        </label>

                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            افزودن
                        </button>
                    </form>
                }
            </div>

            <div class="dependency-column">
                <h5><i class="fa-solid fa-arrow-right-long"></i> این‌ها به این Task وابسته‌اند</h5>

                @if (!Model.Dependency.Dependents.Any())
                {
                    <p class="team-empty-text">هیچ Task ای به این وابسته نیست.</p>
                }
                else
                {
                    @foreach (var dep in Model.Dependency.Dependents)
                    {
                        <div class="dependency-chip">
                            <a asp-action="Details" asp-route-id="@dep.TaskId">@dep.TaskTitle</a>
                            <span class="task-status-badge status-@dep.TaskStatus.ToString().ToLower()">@dep.TaskStatus</span>
                            @if (!dep.IsRequired)
                            {
                                <span class="dependency-optional-badge">اختیاری</span>
                            }
                        </div>
                    }
                }
            </div>

        </div>

        @if (Model.Dependency.ImpactedTasks.Any())
        {
            <div class="dependency-impact-box">
                <h5><i class="fa-solid fa-bolt"></i> نقشه تأثیر کامل (زنجیره‌ای)</h5>
                <div class="dependency-impact-list">
                    @foreach (var impacted in Model.Dependency.ImpactedTasks)
                    {
                        <div class="dependency-impact-item @(impacted.IsRequiredChain ? "required" : "optional")">
                            <span class="dependency-depth-badge">سطح @impacted.Depth</span>
                            <a asp-action="Details" asp-route-id="@impacted.TaskId">@impacted.Title</a>
                            @if (impacted.IsRequiredChain && impacted.ProjectedDueDate.HasValue && impacted.ProjectedDueDate != impacted.OriginalDueDate)
                            {
                                <span class="dependency-projected-date">
                                    موعد جدید تخمینی: @impacted.ProjectedDueDate.Value.ToString("yyyy/MM/dd")
                                </span>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-list-check"></i>
            SubTask ها
            @if (Model.SubTasksTotal > 0)
            {
                <span class="subtask-progress-text">(@Model.SubTasksCompleted از @Model.SubTasksTotal)</span>
            }
        </div>

        @if (Model.CanManage)
        {
            <button type="button" id="aiSuggestBtn" class="ai-suggest-btn" data-task-id="@Model.Id">
                <i class="fa-solid fa-wand-magic-sparkles"></i>
                پیشنهاد زیروظایف با AI
            </button>
        }

        @if (Model.SubTasksTotal > 0)
        {
            <div class="subtask-progress-track">
                <div class="subtask-progress-fill" style="width:@Model.SubTasksProgressPercent%"></div>
            </div>
        }

        @if (!Model.SubTasks.Any())
        {
            <div class="team-empty-text">هنوز SubTask ای برای این Task ثبت نشده است.</div>
        }
        else
        {
            <div class="subtask-list">
                @foreach (var sub in Model.SubTasks)
                {
                    <div class="subtask-item @(sub.IsCompleted ? "completed" : "")" data-id="@sub.Id">
                        <label class="subtask-checkbox-wrap">
                            <input type="checkbox"
                                   class="subtask-toggle"
                                   data-id="@sub.Id"
                                   data-task-id="@Model.Id"
                                   checked="@sub.IsCompleted"
                                   disabled="@(!Model.CanManage)" />
                            <span class="subtask-title">@sub.Title</span>
                        </label>

                        @if (Model.CanManage)
                        {
                            <form asp-controller="SubTask" asp-action="Delete" method="post" class="delete-subtask-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@sub.Id" />
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <button type="submit" class="subtask-delete-btn">
                                    <i class="fa-solid fa-xmark"></i>
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.CanManage)
        {
            <form asp-controller="SubTask" asp-action="QuickAdd" method="post" class="subtask-quick-add">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <i class="fa-solid fa-plus"></i>
                <input type="text" name="title" placeholder="افزودن SubTask جدید... (Enter بزنید)" required maxlength="250" />
                <button type="submit">افزودن</button>
            </form>
        }
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-paperclip"></i>
            فایل‌های پیوست
        </div>

        @if (!Model.Attachments.Any())
        {
            <div class="team-empty-text">هنوز فایلی پیوست نشده است.</div>
        }
        else
        {
            <div class="attachment-list">
                @foreach (var file in Model.Attachments)
                {
                    <div class="attachment-item">
                        <i class="fa-solid fa-file"></i>
                        <div class="attachment-info">
                            <a href="@file.FilePath" target="_blank" class="attachment-name">@file.FileName</a>
                            <span class="attachment-meta">@file.FileSizeDisplay — @file.UploaderName — @file.CreateDate.ToString("yyyy/MM/dd")</span>
                        </div>

                        @if (file.CanDelete)
                        {
                            <form asp-controller="Attachment" asp-action="Delete" method="post" class="delete-attachment-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@file.Id" />
                                <input type="hidden" name="taskItemId" value="@Model.Id" />
                                <button type="submit" class="subtask-delete-btn"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        }
                    </div>
                }
            </div>
        }

        @if (Model.CanManage)
        {
            <form asp-controller="Attachment" asp-action="Upload" method="post" enctype="multipart/form-data" class="attachment-upload-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="taskItemId" value="@Model.Id" />
                <input type="file" name="file" required />
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-upload"></i>
                    آپلود
                </button>
            </form>
        }
    </div>

    <div class="details-card">
        <div class="card-title">
            <i class="fa-solid fa-comments"></i>
            نظرات
            <span class="subtask-progress-text">(@Model.Comments.Count)</span>
        </div>

        @if (!Model.Comments.Any())
        {
            <div class="team-empty-text">هنوز نظری ثبت نشده است.</div>
        }
        else
        {
            <div class="comment-list">
                @foreach (var comment in Model.Comments)
                {
                    <div class="comment-item">
                        <div class="comment-avatar"><i class="fa-regular fa-circle-user"></i></div>
                        <div class="comment-body">
                            <div class="comment-header">
                                <span class="comment-author">@comment.AuthorName</span>
                                <span class="comment-date">
                                    @comment.CreateDate.ToString("yyyy/MM/dd HH:mm")
                                    @if (comment.IsEdited)
                                    {
                                        <span>(ویرایش‌شده)</span>
                                    }
                                </span>
                            </div>
                            <p class="comment-content">@comment.Content</p>

                            @if (comment.CanDelete)
                            {
                                <form asp-controller="Comment" asp-action="Delete" method="post" class="delete-comment-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="commentId" value="@comment.Id" />
                                    <input type="hidden" name="taskItemId" value="@Model.Id" />
                                    <button type="submit" class="comment-delete-btn">
                                        <i class="fa-solid fa-trash"></i>
                                        حذف
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <form asp-controller="Comment" asp-action="Add" method="post" class="comment-add-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskItemId" value="@Model.Id" />
            <textarea name="content" rows="2" class="form-control" placeholder="نظر خود را بنویسید..." required></textarea>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-paper-plane"></i>
                ارسال نظر
            </button>
        </form>
    </div>

    @if (Model.CanManage)
    {
        <div class="details-card">
            <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="delete-task-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">
                    <i class="fa-solid fa-trash"></i>
                    حذف Task
                </button>
            </form>
        </div>
    }

</div>

<div class="ai-modal-overlay" id="aiModalOverlay">
    <div class="ai-modal">
        <div class="ai-modal-header">
            <h3><i class="fa-solid fa-wand-magic-sparkles"></i> پیشنهادهای هوش مصنوعی</h3>
            <button type="button" id="aiModalClose" class="ai-modal-close"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="ai-modal-body" id="aiModalBody"></div>

        <form asp-action="AddAiSubTasks" method="post" id="aiSubTaskForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="taskId" value="@Model.Id" />
            <div id="aiHiddenInputs"></div>

            <div class="ai-modal-footer">
                <button type="button" id="aiModalCancel" class="btn btn-light">انصراف</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    افزودن انتخاب‌شده‌ها
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts
{
    <script src="~/js/task.js" asp-append-version="true"></script>
}