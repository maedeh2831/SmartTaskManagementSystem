@model SmartTask.Web.Models.ViewModels.Sprint.SprintPlanningViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "برنامه‌ریزی اسپرینت";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/workspace.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/sprint.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/planning.css"
          asp-append-version="true" />
}

<div class="workspace-container">

    <!-- =====================================================
         Hero
         ===================================================== -->
    <div class="workspace-hero">

        <div class="workspace-hero-content">

            <div class="sprint-eyebrow">

                <i class="fa-solid fa-folder"></i>

                پروژهٔ @Model.ProjectName

            </div>


            <h1>
                برنامه‌ریزی @Model.SprintName
            </h1>


            <p>
                User Story ها را از Product Backlog انتخاب کرده
                و برای این اسپرینت برنامه‌ریزی کنید.
            </p>

        </div>


        <!-- Toolbar -->
        <div class="workspace-toolbar">

            <div class="workspace-hero-actions">

                <a asp-action="Details"
                   asp-route-id="@Model.SprintId"
                   class="workspace-filter">

                    <i class="fa-solid fa-arrow-right"></i>

                    بازگشت به اسپرینت

                </a>

            </div>

        </div>

    </div>


    <!-- =====================================================
         Planning Content
         ===================================================== -->
    <div class="planning-page">

        <partial name="_PlanningPartial"
                 model="Model" />

    </div>

</div>


<!-- =========================================================
     Anti Forgery
     ========================================================= -->
<form id="antiForgeryForm"
      method="post"
      style="display:none;">

    @Html.AntiForgeryToken()

</form>


@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>

    <script src="~/js/planning.js"
            asp-append-version="true"></script>
}