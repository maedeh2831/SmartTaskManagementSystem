@model SmartTask.Web.Models.ViewModels.Sprint.EditSprintViewModel

@{
    ViewData["Title"] = "ویرایش اسپرینت";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprint.css" asp-append-version="true" />
}

<div class="workspace-create-page">

    <div class="page-header">
        <div>
            <h1>ویرایش اسپرینت</h1>
            <p>اطلاعات اسپرینت را به‌روزرسانی کنید.</p>
        </div>

        <a asp-action="Details" asp-route-id="@Model.Id" class="back-link">
            <i class="fa-solid fa-arrow-right"></i>
            بازگشت
        </a>
    </div>

    <div class="workspace-layout">

        <div class="workspace-form">

            <div class="workspace-form-card">

                <div class="form-title">
                    <div class="workspace-icon">
                        <i class="fa-solid fa-pen-to-square"></i>
                    </div>
                    <div>
                        <h3>اطلاعات اسپرینت</h3>
                        <p>تغییرات موردنظر را اعمال کنید.</p>
                    </div>
                </div>

                <form asp-action="Edit" method="post">

                    <input asp-for="Id" type="hidden" />
                    <input asp-for="ProjectId" type="hidden" />

                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" id="sprintName" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Goal"></label>
                        <textarea asp-for="Goal" id="sprintGoal" rows="3" class="form-control"></textarea>
                        <span asp-validation-for="Goal" class="text-danger"></span>
                    </div>

                    <div class="sprint-date-row">
                        <div class="form-group">
                            <label asp-for="StartDate"></label>
                            <input asp-date-for="StartDate" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="form-group">
                            <label asp-for="EndDate"></label>
                            <input asp-date-for="EndDate" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Capacity"></label>
                        <input asp-for="Capacity" type="number" min="1" max="999" class="form-control" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-light">انصراف</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-floppy-disk"></i>
                            ذخیره تغییرات
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sprint.js" asp-append-version="true"></script>
}