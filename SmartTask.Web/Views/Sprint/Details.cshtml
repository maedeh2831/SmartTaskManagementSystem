@model SmartTask.Web.Models.ViewModels.Sprint.SprintDetailsViewModel
@using SmartTask.Web.Models.Enums

@{
    ViewData["Title"] = "جزئیات اسپرینت";
    var statusClass = Model.Status.ToString().ToLower();
    var statusLabel = Model.Status switch
    {
        SprintStatusType.Planning   => "برنامه‌ریزی",
        SprintStatusType.Active     => "فعال",
        SprintStatusType.Completed  => "پایان یافته",
        SprintStatusType.Cancelled  => "لغو شده",
        _                           => "-"
    };
    var statusIcon = Model.Status switch
    {
        SprintStatusType.Planning   => "fa-flag",
        SprintStatusType.Active     => "fa-bolt",
        SprintStatusType.Completed  => "fa-flag-checkered",
        SprintStatusType.Cancelled  => "fa-ban",
        _                           => "fa-circle"
    };

    // Cycle ring: elapsed time as an arc, days remaining in the center
    var ringPercent = Model.Status switch
    {
        SprintStatusType.Completed  => 100,
        SprintStatusType.Cancelled  => 0,
        _                           => Model.ProgressPercent
    };
    var ringIsIcon = Model.Status == SprintStatusType.Completed
                  || Model.Status == SprintStatusType.Cancelled;
    var ringIcon = Model.Status == SprintStatusType.Completed ? "fa-check" : "fa-xmark";
    var ringNumber = Model.Status == SprintStatusType.Active
        ? (Model.TotalDays - Model.ElapsedDays).ToString()
        : Model.TotalDays.ToString();
    var ringLabel = Model.Status switch
    {
        SprintStatusType.Planning   => "روز برنامه",
        SprintStatusType.Active     => "روز مانده",
        SprintStatusType.Completed  => "تمام شد",
        SprintStatusType.Cancelled  => "لغو شد",
        _                           => "-"
    };
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css"     asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprint.css"        asp-append-version="true" />
    <link rel="stylesheet" href="~/css/planning.css"      asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprintreport.css"  asp-append-version="true" />
}

<div class="workspace-container">
    @Html.AntiForgeryToken()

    <!-- ===== Hero ===== -->
    <div class="workspace-hero sprint-detail-hero">

        <div class="sprint-detail-ring" title="پیشرفت زمان اسپرینت">
            <svg class="sprint-ring" viewBox="0 0 120 120" aria-hidden="true">
                <circle class="sprint-ring-track" cx="60" cy="60" r="50"></circle>
                <circle class="sprint-ring-fill status-@statusClass"
                        cx="60" cy="60" r="50"
                        stroke-dasharray="314.2"
                        data-percent="@ringPercent"
                        transform="rotate(-90 60 60)"></circle>
            </svg>
            <div class="sprint-ring-center status-@statusClass">
                @if (ringIsIcon)
                {
                    <strong class="sprint-ring-num"><i class="fa-solid @ringIcon"></i></strong>
                }
                else
                {
                    <strong class="sprint-ring-num fa-digits">@ringNumber</strong>
                }
                <span class="sprint-ring-label">@ringLabel</span>
            </div>
        </div>

        <div class="workspace-hero-content">
            <div class="sprint-eyebrow">
                <i class="fa-solid fa-folder"></i>
                پروژهٔ @Model.ProjectName
            </div>
            <h1>
                @Model.Name
                @if (Model.CanManage)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id"
                       class="sprint-edit-inline" title="ویرایش اسپرینت">
                        <i class="fa-solid fa-pen"></i>
                    </a>
                }
                <span class="sprint-status-badge status-@statusClass">
                    <i class="fa-solid @statusIcon"></i>
                    @statusLabel
                </span>
            </h1>
            <div class="sprint-hero-meta">
                <span>
                    <i class="fa-regular fa-calendar"></i>
                    @Html.DisplayDate(Model.StartDate) تا @Html.DisplayDate(Model.EndDate)
                </span>
                <span>
                    <i class="fa-solid fa-gauge-high"></i>
                    ظرفیت <strong class="fa-digits">@Model.Capacity</strong> Story Point
                </span>
                <span>
                    <i class="fa-solid fa-hourglass-half"></i>
                    <strong class="fa-digits">@Model.ElapsedDays</strong> از <strong class="fa-digits">@Model.TotalDays</strong> روز
                </span>
            </div>
        </div>

        <div class="workspace-toolbar sprint-hero-actions">

            <a asp-action="Index" asp-route-projectId="@Model.ProjectId"
               class="workspace-filter">
                <i class="fa-solid fa-arrow-right"></i>
                بازگشت
            </a>

            @if (Model.CanManage)
            {
                <div class="sprint-more-actions">
                    <button type="button" class="workspace-filter sprint-more-btn"
                            id="sprintMoreBtn" title="بیشتر">
                        <i class="fa-solid fa-ellipsis"></i>
                    </button>
                    <div class="sprint-more-menu" id="sprintMoreMenu">
                        <form asp-action="Delete" asp-route-id="@Model.Id"
                              method="post" class="delete-sprint-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="sprint-more-item danger">
                                <i class="fa-solid fa-trash"></i>
                                حذف اسپرینت
                            </button>
                        </form>
                    </div>
                </div>
            }

        </div>

    </div>

    <!-- ===== Time progress strip ===== -->
    <div class="sprint-progress-strip">
        <span class="sprint-progress-label">
            <i class="fa-solid fa-hourglass-half"></i>
            پیشرفت زمان
            <strong class="fa-digits">@(Model.Status == SprintStatusType.Completed ? 100 : Model.ProgressPercent)%</strong>
        </span>
        <div class="sprint-progress-track">
            <div class="sprint-progress-fill status-@statusClass"
                 style="width:@(Model.Status == SprintStatusType.Completed ? 100 : Model.ProgressPercent)%"></div>
        </div>
        <span class="sprint-progress-days">
            <strong class="fa-digits">@Model.ElapsedDays</strong> از <strong class="fa-digits">@Model.TotalDays</strong> روز سپری شده
        </span>
    </div>

    <!-- ===== Tab Bar ===== -->
    <div class="sprint-tabs" id="sprintTabs">
        <button class="sprint-tab active" data-tab="overview">
            <i class="fa-solid fa-bullseye"></i>
            نمای کلی
        </button>
        <button class="sprint-tab" data-tab="stories">
            <i class="fa-solid fa-list-check"></i>
            User Story ها
        </button>
        @if (Model.CanManage)
        {
            <button class="sprint-tab" data-tab="planning"
                    data-lazy-url="/Sprint/PlanningTab/@Model.Id">
                <i class="fa-solid fa-diagram-project"></i>
                برنامه‌ریزی
            </button>
        }
        <a asp-controller="AgileDashboard" asp-action="Index"
           asp-route-projectId="@Model.ProjectId" asp-route-sprintId="@Model.Id"
           class="sprint-tab sprint-tab-external" target="_blank" rel="noopener"
           title="داشبورد Agile (باز شدن در تب جدید)">
            <i class="fa-solid fa-chart-line"></i>
            داشبورد Agile
            <i class="fa-solid fa-arrow-up-right-from-square sprint-tab-ext-icon"></i>
        </a>
        <span class="sprint-tab-indicator" id="sprintTabIndicator"></span>
    </div>

    <!-- ===== Tab: نمای کلی ===== -->
    <div class="sprint-tab-pane active" id="tab-overview">

        <div class="details-card">
            <div class="card-title">
                <i class="fa-solid fa-bullseye"></i>
                هدف اسپرینت
            </div>
            <p>@(string.IsNullOrWhiteSpace(Model.Goal)
                  ? "هدفی برای این اسپرینت تعیین نشده است."
                  : Model.Goal)</p>
        </div>

        <div class="sprint-stat-grid">
            <div class="sprint-stat">
                <i class="fa-solid fa-calendar-days"></i>
                <div>
                    <strong class="fa-digits">@Model.TotalDays</strong>
                    <span>روز مدت دوره</span>
                </div>
            </div>
            <div class="sprint-stat">
                <i class="fa-solid fa-hourglass-half"></i>
                <div>
                    <strong class="fa-digits">@Model.ElapsedDays</strong>
                    <span>روز سپری شده</span>
                </div>
            </div>
            <div class="sprint-stat">
                <i class="fa-solid fa-gauge-high"></i>
                <div>
                    <strong class="fa-digits">@Model.Capacity</strong>
                    <span>ظرفیت (Story Point)</span>
                </div>
            </div>
        </div>

        @if (Model.CanManage)
        {
            <div class="sprint-action-buttons">
                @if (Model.Status == SprintStatusType.Planning)
                {
                    <form asp-action="Activate" asp-route-id="@Model.Id"
                          method="post" class="activate-sprint-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="workspace-primary-btn">
                            <i class="fa-solid fa-play"></i>
                            فعال‌سازی اسپرینت
                        </button>
                    </form>
                }
                @if (Model.Status == SprintStatusType.Active)
                {
                    <form asp-action="Complete" asp-route-id="@Model.Id"
                          method="post" class="complete-sprint-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="workspace-filter">
                            <i class="fa-solid fa-flag-checkered"></i>
                            بستن اسپرینت
                        </button>
                    </form>
                }
            </div>
        }

        @if (Model.Status == SprintStatusType.Completed)
        {
            <div class="details-card">
                <div class="card-title">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    گزارش هوشمند پایان اسپرینت
                </div>
                <div id="sprintReportList" class="sprint-report-list"
                     data-sprint-id="@Model.Id">
                    <div class="team-empty-text">در حال بارگذاری گزارش‌ها...</div>
                </div>
                @if (Model.CanManage)
                {
                    <button type="button" id="generateSprintReportBtn"
                            class="ai-suggest-btn" data-sprint-id="@Model.Id">
                        <i class="fa-solid fa-wand-magic-sparkles"></i>
                        تولید گزارش جدید
                    </button>
                }
            </div>
        }

    </div>

    <!-- ===== Tab: User Story ها ===== -->
    <div class="sprint-tab-pane" id="tab-stories">
        <div class="workspace-empty">
            <i class="fa-solid fa-list-check"></i>
            <h3>User Story های این اسپرینت از تب برنامه‌ریزی مدیریت می‌شوند</h3>
            <p>داستان‌های کاربری را از Product Backlog انتخاب و به این اسپرینت اضافه کنید.</p>
            @if (Model.CanManage)
            {
                <div class="workspace-empty-action">
                    <button type="button" id="goToPlanningBtn" class="workspace-primary-btn">
                        <i class="fa-solid fa-diagram-project"></i>
                        رفتن به برنامه‌ریزی
                    </button>
                </div>
            }
        </div>
    </div>

    <!-- ===== Tab: برنامه‌ریزی (lazy) ===== -->
    @if (Model.CanManage)
    {
        <div class="sprint-tab-pane" id="tab-planning">
            <div class="planning-loading">
                <i class="fa-solid fa-spinner fa-spin"></i>
                <span>در حال بارگذاری...</span>
            </div>
        </div>
    }

</div>

@section Scripts
{
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.15.2/Sortable.min.js"></script>
    <script src="~/js/sprint.js"   asp-append-version="true"></script>
    <script src="~/js/planning.js" asp-append-version="true"></script>
}
