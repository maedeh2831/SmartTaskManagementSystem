@model SmartTask.Web.Models.ViewModels.Sprint.CreateSprintViewModel

@{
    ViewData["Title"] = "اسپرینت جدید";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/sprint.css" asp-append-version="true" />
}

<div class="workspace-create-page">

    <div class="page-header">
        <div>
            <h1>ایجاد اسپرینت جدید</h1>
            <p>یک چرخه Agile جدید برای این پروژه تعریف کنید.</p>
        </div>

        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="back-link">
            <i class="fa-solid fa-arrow-right"></i>
            بازگشت
        </a>
    </div>

    <div class="workspace-layout">

        <div class="workspace-form">

            <div class="workspace-form-card">

                <div class="form-title">
                    <div class="workspace-icon">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <div>
                        <h3>اطلاعات اسپرینت</h3>
                        <p>اطلاعات زیر را تکمیل کنید.</p>
                    </div>
                </div>

                <form asp-action="Create" method="post">

                    <input asp-for="ProjectId" type="hidden" />

                    <div class="form-group">
                        <label asp-for="Name"></label>
                        <input asp-for="Name" id="sprintName" class="form-control" placeholder="مثلاً Sprint 1" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Goal"></label>
                        <textarea asp-for="Goal" id="sprintGoal" rows="3" class="form-control" placeholder="هدف اصلی این اسپرینت چیست؟"></textarea>
                        <span asp-validation-for="Goal" class="text-danger"></span>
                    </div>

                    <div class="sprint-date-row">
                        <div class="form-group">
                            <label asp-for="StartDate"></label>
                            <input asp-date-for="StartDate" id="sprintStart" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="EndDate"></label>
                            <input asp-date-for="EndDate" id="sprintEnd" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Capacity"></label>
                        <input asp-for="Capacity" id="sprintCapacity" type="number" min="1" max="999" class="form-control" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>

                    <div class="form-actions">
                        <a asp-action="Index" asp-route-projectId="@Model.ProjectId" class="btn btn-light">انصراف</a>
                        <button type="submit" class="btn btn-primary">
                            <i class="fa-solid fa-plus"></i>
                            ایجاد اسپرینت
                        </button>
                    </div>

                </form>

            </div>

        </div>

        <div class="workspace-preview">

            <div class="preview-card">

                <div class="preview-card-header">
                    <div class="preview-logo sprint-preview-logo">
                        <i class="fa-solid fa-bolt"></i>
                    </div>
                    <div>
                        <h4 id="previewName">اسپرینت جدید</h4>
                        <small id="previewDuration">۱۴ روز</small>
                    </div>
                </div>

                <div id="previewGoal" class="preview-description">
                    هدف اسپرینت اینجا نمایش داده خواهد شد...
                </div>

                <div class="preview-stats">
                    <div>
                        <i class="fa-solid fa-gauge-high"></i>
                        <span id="previewCapacity">۲۰ ظرفیت</span>
                    </div>
                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/sprint.js" asp-append-version="true"></script>
}