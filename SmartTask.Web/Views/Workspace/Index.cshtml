@model SmartTask.Web.Models.ViewModels.Workspace.WorkspaceIndexViewModel

@{
    ViewData["Title"] = "فضاهای کاری";
}

@section Styles
{
    <link rel="stylesheet"
          href="~/css/workspace.css"
          asp-append-version="true" />
}

<div class="workspace-container">

    <!-- Hero -->

    <div class="workspace-hero">

        <div class="workspace-hero-content">

            <h1>فضاهای کاری</h1>

            <p>
                پروژه‌ها، اعضا و تیم‌های خود را در یک محیط حرفه‌ای مدیریت کنید.
            </p>

        </div>

        <div class="workspace-toolbar">

            <div class="workspace-search">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       placeholder="جستجوی فضای کاری..." />

            </div>

            <div style="display:flex;gap:12px;">

                <div class="workspace-filter">

                    <button>

                        <i class="fa-solid fa-sliders"></i>

                        فیلتر

                    </button>

                </div>

                <a asp-action="Create"
                   class="workspace-create-btn">

                    <i class="fa-solid fa-plus"></i>

                    ایجاد فضای کاری

                </a>

            </div>

        </div>

    </div>

    @if (!Model.Workspaces.Any())
    {
        <div class="workspace-empty">

            <i class="fa-solid fa-layer-group"></i>

            <h3>هنوز فضای کاری ندارید.</h3>

            <p>
                اولین فضای کاری خود را ایجاد کنید.
            </p>

        </div>
    }
    else
    {
        <div class="workspace-grid">

            @foreach (var item in Model.Workspaces)
            {
                <div class="workspace-card">

                    <div class="workspace-card-header"
                         style="background:@item.Color">

                        <div class="workspace-logo">
                            @if (!string.IsNullOrWhiteSpace(item.Logo))
                            {
                                <img src="@item.Logo" alt="@item.Name" />
                            }
                            else
                            {
                                <i class="fa-solid fa-layer-group"></i>
                            }
                    </div>

                        <span class="workspace-status">
                            @item.Visibility
                        </span>

                    </div>


                    <div class="workspace-card-content">


                        <h3>
                            @item.Name
                        </h3>


                        <p>
                            @(string.IsNullOrWhiteSpace(item.Description)
                                                ? "بدون توضیحات"
                                                : item.Description)
                </p>



                        <div class="workspace-info">


                            <div>
                                <i class="fa-solid fa-folder"></i>
                                <span>
                                    @item.ProjectsCount پروژه
                                </span>
                            </div>


                            <div>
                                <i class="fa-solid fa-users"></i>
                                <span>
                                    @item.MembersCount عضو
                                </span>
                            </div>


                        </div>


                    </div>



                    <div class="workspace-card-footer">


                        <small>
                            @item.CreateDate.ToString("yyyy/MM/dd")
                        </small>


                        <div class="workspace-actions">


                            <a asp-controller="Workspace"
                               asp-action="Details"
                               asp-route-id="@item.Id"
                               class="workspace-open-btn">

                                ورود
                                <i class="fa-solid fa-arrow-left"></i>

                            </a>



                            <form asp-controller="Workspace"
                                  asp-action="Delete"
                                  asp-route-id="@item.Id"
                                  method="post"
                                  class="delete-form">


                                @Html.AntiForgeryToken()


                                <button class="workspace-delete-btn">

                                    <i class="fa-solid fa-trash"></i>

                                </button>


                            </form>


                        </div>


                    </div>


                </div>
                }

        </div>
    }

</div>
@section Scripts
{
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js"
            asp-append-version="true"></script>
}