@model SmartTask.Web.Models.ViewModels.Workspace.CreateWorkspaceViewModel

@{
    ViewData["Title"] = "ایجاد فضای کاری";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/workspace.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/workspace-pages.css"
          asp-append-version="true" />
}

<div class="workspace-create-page">

    <div class="page-header">

        <div>

            <h1>ایجاد فضای کاری</h1>

            <p>
                یک Workspace جدید ایجاد کنید و اعضای تیم خود را مدیریت نمایید.
            </p>

        </div>

        <a asp-action="Index" class="back-link">

            <i class="fa-solid fa-arrow-right"></i>

            بازگشت

        </a>

    </div>

    <div class="workspace-layout">

        <!-- ================= Form ================= -->

        <div class="workspace-form">

            <div class="workspace-form-card">

                <div class="form-title">

                    <div class="workspace-icon">

                        <i class="fa-solid fa-layer-group"></i>

                    </div>

                    <div>

                        <h3>اطلاعات Workspace</h3>

                        <p>
                            اطلاعات زیر را تکمیل کنید.
                        </p>

                    </div>

                </div>

                <form asp-action="Create"
                      method="post">

                    <div class="form-group">

                        <label asp-for="Name"></label>

                        <input asp-for="Name"
                               id="workspaceName"
                               class="form-control"
                               placeholder="مثلاً تیم طراحی محصول" />

                        <span asp-validation-for="Name"
                              class="text-danger"></span>

                    </div>

                    <div class="form-group">

                        <label asp-for="Description"></label>

                        <textarea asp-for="Description"
                                  id="workspaceDescription"
                                  rows="4"
                                  class="form-control"
                                  placeholder="توضیح کوتاهی درباره Workspace..."></textarea>

                    </div>

                    <div class="form-group">

                        <label>رنگ Workspace</label>

                        <div class="workspace-colors">

                            <label>
                                <input asp-for="Color" class="color-radio" value="#4F46E5" checked type="radio">
                                <span style="background:#4F46E5"></span>
                            </label>

                            <label>
                                <input asp-for="Color" class="color-radio" value="#06B6D4" type="radio">
                                <span style="background:#06B6D4"></span>
                            </label>

                            <label>
                                <input asp-for="Color" class="color-radio" value="#10B981" type="radio">
                                <span style="background:#10B981"></span>
                            </label>

                            <label>
                                <input asp-for="Color" class="color-radio" value="#F59E0B" type="radio">
                                <span style="background:#F59E0B"></span>
                            </label>

                            <label>
                                <input asp-for="Color" class="color-radio" value="#EF4444" type="radio">
                                <span style="background:#EF4444"></span>
                            </label>

                        </div>

                    </div>

                    <div class="form-group">

                        <label>سطح دسترسی</label>

                        <div class="visibility-box">

                            <label>

                                <input asp-for="Visibility"
                                       class="visibility-radio"
                                       value="1"
                                       checked
                                       type="radio" />

                                <i class="fa-solid fa-lock"></i>

                                خصوصی

                            </label>

                            <label>

                                <input asp-for="Visibility"
                                       class="visibility-radio"
                                       value="2"
                                       type="radio" />

                                <i class="fa-solid fa-globe"></i>

                                عمومی

                            </label>

                        </div>

                    </div>

                    <div class="form-actions">

                        <a asp-action="Index"
                           class="btn btn-light">

                            انصراف

                        </a>

                        <button type="submit"
                                class="btn btn-primary">

                            <i class="fa-solid fa-plus"></i>

                            ایجاد Workspace

                        </button>

                    </div>

                </form>

            </div>

        </div>

        <!-- ================= Preview ================= -->

        <div class="workspace-preview">

            <div class="preview-card">

                <div class="preview-card-header">

                    <div id="previewLogo"
                         class="preview-logo">

                        <i class="fa-solid fa-layer-group"></i>

                    </div>

                    <div>

                        <h4 id="previewName">

                            Workspace جدید

                        </h4>

                        <small id="previewVisibility">

                            <i class="fa-solid fa-lock"></i>

                            خصوصی

                        </small>

                    </div>

                </div>

                <div id="previewDescription"
                     class="preview-description">

                    توضیح Workspace اینجا نمایش داده خواهد شد...

                </div>

                <div class="preview-stats">

                    <div>

                        <i class="fa-solid fa-users"></i>

                        ۰ عضو

                    </div>

                    <div>

                        <i class="fa-solid fa-folder-open"></i>

                        ۰ پروژه

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>

        const nameInput = document.getElementById("workspaceName");
        const descInput = document.getElementById("workspaceDescription");

        const previewName = document.getElementById("previewName");
        const previewDesc = document.getElementById("previewDescription");
        const previewLogo = document.getElementById("previewLogo");
        const previewVisibility = document.getElementById("previewVisibility");

        nameInput.addEventListener("input", () => {

            previewName.innerText =
                nameInput.value || "Workspace جدید";

        });

        descInput.addEventListener("input", () => {

            previewDesc.innerText =
                descInput.value || "توضیح Workspace اینجا نمایش داده خواهد شد...";

        });

        document.querySelectorAll(".color-radio")
            .forEach(x => {

                x.addEventListener("change", () => {

                    previewLogo.style.background = x.value;

                });

            });

        document.querySelectorAll(".visibility-radio")
            .forEach(x => {

                x.addEventListener("change", () => {

                    previewVisibility.innerHTML =
                        x.value == "1"
                            ? '<i class="fa-solid fa-lock"></i> خصوصی'
                            : '<i class="fa-solid fa-globe"></i> عمومی';

                });

            });

    </script>

}