@model SmartTask.Web.Models.ViewModels.Reminder.EditReminderViewModel

@{
    ViewData["Title"] = "ویرایش یادآوری";
}

@section Styles
{
    <link rel="stylesheet" href="~/css/workspace.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reminder.css" asp-append-version="true" />
}

<div class="workspace-details-page">

    <div class="page-header">
        <div>
            <h1>ویرایش یادآوری</h1>
            <p>Task: @Model.TaskTitle</p>
        </div>
        <a asp-action="Index" class="back-link">
            <i class="fa-solid fa-arrow-right"></i>
            بازگشت
        </a>
    </div>

    <div class="details-card">
        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" maxlength="250" required />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label">تاریخ و ساعت یادآوری</label>
                <input type="datetime-local" name="ReminderDate" class="form-control"
                       value="@Model.ReminderDate.ToString("yyyy-MM-ddTHH:mm")" required />
                <span asp-validation-for="ReminderDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-check"></i>
                ذخیره تغییرات
            </button>
        </form>
    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}